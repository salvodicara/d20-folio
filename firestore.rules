rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from an authenticated user?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the authenticated user not blocked?
    // Uses get() — only call this on paths where the user doc is guaranteed to exist
    // (i.e. after first sign-in completes). Do NOT use on the /users/{uid} path itself.
    function isNotBlocked() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked";
    }

    // Helper: is the user an admin? DATA-DRIVEN — reads `role: "admin"` from the
    // requester's own user doc (the SAME field the client's `useIsAdmin` reads), so
    // client + rules can't drift and no uid is hardcoded. Granted out-of-band
    // (Firestore console / an admin script); never settable by the client (update
    // is admin-only, create forbids it — see below). Assumes the user doc exists
    // (same precondition as isNotBlocked); `data.get("role", "")` treats a doc
    // without the field as simply "not admin" rather than erroring.
    function isAdmin() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin";
    }

    // The anonymous share surface is a SANITIZED, derived projection — never the
    // private character parent. Its closed schema deliberately excludes state,
    // portraitUrl, campaign attachment/invite facts, ownership markers, and every
    // future internal field unless this allowlist is consciously widened.
    function isExactPublicCharacterSheet(sheet, character) {
      return sheet is map
        && sheet.keys().hasAll([
          'publicSchema',
          'schema',
          'build',
          'cache',
          'status',
          'hasPortrait',
          'portraitCrop',
          'sourceUpdatedAt'
        ])
        && sheet.keys().hasOnly([
          'publicSchema',
          'schema',
          'build',
          'cache',
          'status',
          'hasPortrait',
          'portraitCrop',
          'sourceUpdatedAt'
        ])
        && sheet.publicSchema == 1
        && sheet.schema == 3
        && character.schema == 3
        && character.state is map
        && character.state.size() == 0
        && sheet.build == character.build
        && sheet.cache == character.cache
        && sheet.status == character.status
        && sheet.status in ['active', 'retired', 'dead', 'archived']
        && sheet.hasPortrait
             == (character.get('portraitUrl', '') is string
                 && character.get('portraitUrl', '').size() > 0)
        && sheet.portraitCrop
             == (sheet.hasPortrait ? character.get('portraitCrop', null) : null)
        && character.updatedAt is timestamp
        && sheet.sourceUpdatedAt is timestamp
        && sheet.sourceUpdatedAt == character.updatedAt;
    }

    // Users collection
    // - Read own doc: only auth required (no get() loop)
    // - Create own doc: first sign-in bootstrap — but MUST NOT self-assign the
    //   admin role (that's the self-promotion vector; admin is granted out-of-band)
    // - Update: ADMIN (full — block/unblock, grant role) OR the owner's OWN
    //   telemetry-only self-update (the recurring `lastActiveAt` sign-in bump in
    //   `src/lib/auth.ts`). A non-admin may touch ONLY their own `lastActiveAt` and
    //   NOTHING else — never `role` (the role-escalation vector) and never `status`
    //   (the self-UNBLOCK vector). The field-lock uses the SAME
    //   diff().affectedKeys().hasOnly() construct proven in the campaign rules. A
    //   non-admin still cannot touch ANOTHER user's doc (the request.auth.uid == uid
    //   guard). Before this, `update` was admin-only, so a normal user's recurring
    //   lastActiveAt write was silently DENIED (it only ever landed for admins) —
    //   this fixes that latent gap while keeping role/status admin-only.
    // - List: admin only
    match /users/{uid} {
      // A non-admin may update ONLY their own doc and ONLY the `lastActiveAt`
      // telemetry field — defined INSIDE the match so the `{uid}` wildcard is in
      // scope. Same diff().affectedKeys().hasOnly() construct proven in the
      // campaign rules.
      function isSelfTelemetryUpdate() {
        return request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActiveAt"]);
      }
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.get("role", "") != "admin";
      allow update: if isAdmin() || isSelfTelemetryUpdate();
      allow list:   if isAdmin();
    }

    // Characters — users CRUD their own (blocked check applied here, user doc
    // exists by now). Admin can read all (for stats). A CO-MEMBER reads a peer's
    // REAL character doc THE SAME WAY the owner's cockpit does (ONE load path):
    // sheets are fully open to the team — every campaign member may READ every other
    // member's sheet (secrecy is DM-vs-players, never player-vs-player).
    //
    // CROSS-USER ACCESS IS DERIVED LIVE — THE SINGLE SOURCE OF TRUTH IS THE CAMPAIGN
    // DOC. The character carries ONE pointer, `attachedCampaignId` (written
    // ATOMICALLY with the campaign's `memberDetails` by the attach transaction —
    // `campaign-io.attachMemberCharacter`); the grant is "the requester AND target
    // owner are CURRENT members of THAT campaign, whose target roster row names this
    // exact character", read live off the campaign doc here. There is NO
    // stored reader list to recompute or go stale (the old client-maintained
    // `dmReaders`/`campaignReaders` ACLs — whose convergence failures produced the
    // "DM access out of date" outages — are deleted). A DM transfer or roster change
    // is effective IMMEDIATELY (the next request reads the live campaign doc).
    // Ordinary WRITE stays owner-only. The sole cross-user exception is a campaign
    // DM clearing exactly `attachedCampaignId` in the atomic member-removal or
    // campaign-deletion operation that makes that old claim stale.
    //
    // PUBLIC SHARE LINKS never expose this private parent. Anonymous GET lives at
    // the closed `public/sheet` projection below. Parent + projection are one atomic
    // publication invariant: shared=true requires an exact projection after every
    // write; shared=false/deletion requires its absence.
    match /users/{uid}/characters/{charId} {
      // The campaign this character claims attachment to. Only evaluated AFTER the
      // has-a-claim guard below; a dangling claim (campaign deleted) errors the
      // get() → the branch denies, which is the correct fail-closed behaviour.
      function attachedCampaign() {
        return get(/databases/$(database)/documents/campaigns/$(resource.data.attachedCampaignId)).data;
      }
      // A campaign roster entry is the reciprocal half of attachment. The parent
      // pointer alone is only a claim: stale data must not keep granting the table
      // access after this character's owner is removed or attaches another char.
      function isCurrentCampaignAttachment() {
        let campaign = attachedCampaign();
        return request.auth.uid in campaign.members
          && uid in campaign.members
          && campaign.get('memberDetails', {}).get(uid, {})
               .get('characterId', '') == charId;
      }
      allow read:  if (isNotBlocked() && request.auth.uid == uid)
        || isAdmin()
        || (isNotBlocked()
            && resource.data.get("attachedCampaignId", "") != ""
            && isCurrentCampaignAttachment());
      function publicSheetMatchesAfter() {
        let sheetPath = /databases/$(database)/documents/users/$(uid)/characters/$(charId)/public/sheet;
        return (request.resource.data.get('shared', false) == true
                && existsAfter(sheetPath)
                && isExactPublicCharacterSheet(
                     getAfter(sheetPath).data,
                     request.resource.data
                   ))
          || (request.resource.data.get('shared', false) != true
              && !existsAfter(sheetPath));
      }
      // The parent never carries a play session: the play owner is combat/state (P1).
      function parentStateEmptyAfter() {
        return request.resource.data.state is map
          && request.resource.data.state.size() == 0;
      }
      // Membership, not gameplay: the campaign DM may clear only a departing target's
      // stale claim, and only in the SAME atomic operation that removes the target from
      // both roster projections. Reading the old campaign proves this is a transition,
      // not a standalone edit against an already-stale roster.
      //
      // P4 deletion: this dies with the `table:leave` lease, which makes the owner's own
      // client clear the attachment.
      function isCampaignDmDetach() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let campaign = attachedCampaign();
        return request.auth.uid != uid
          && resource.data.get('attachedCampaignId', '') != ''
          && campaign.dmUid == request.auth.uid
          && uid in campaign.members
          && campaign.get('memberDetails', {}).get(uid, {})
               .get('characterId', '') == charId
          && (!existsAfter(/databases/$(database)/documents/campaigns/$(resource.data.attachedCampaignId))
              || (!(uid in getAfter(/databases/$(database)/documents/campaigns/$(resource.data.attachedCampaignId)).data.members)
                  && !getAfter(/databases/$(database)/documents/campaigns/$(resource.data.attachedCampaignId)).data
                       .get('memberDetails', {}).keys().hasAny([uid])))
          && changed == ['attachedCampaignId'].toSet()
          && !request.resource.data.keys().hasAny(['attachedCampaignId']);
      }
      // P1 — the parent build write is compare-and-set on `revision` (design §5.3).
      // A build/state/cache change REQUIRES exactly resource.revision + 1. Anything
      // else may leave `revision` untouched OR advance it by exactly one: the sharing
      // publish and the snapshot restore rewrite the WHOLE parent with values that
      // often diff to nothing, yet are ordinary generation-advancing writes. `+2` and
      // any stale value are always denied. Offline writes queue and are rejected on
      // reconnect when stale, which the client surfaces as a save error.
      function revisionAdvancesWithBuild() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return request.resource.data.revision is int
          && (request.resource.data.revision == resource.data.revision + 1
              || (!changed.hasAny(['build', 'state', 'cache'])
                  && request.resource.data.revision == resource.data.revision));
      }
      allow create: if isNotBlocked()
        && request.auth.uid == uid
        && request.resource.data.revision == 0
        && parentStateEmptyAfter()
        && publicSheetMatchesAfter();
      allow update: if isNotBlocked()
        && ((request.auth.uid == uid && revisionAdvancesWithBuild())
            || isCampaignDmDetach())
        && parentStateEmptyAfter()
        && publicSheetMatchesAfter();
      allow delete: if isNotBlocked()
        && request.auth.uid == uid
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/$(charId)/public/sheet);
    }

    // The ONE anonymous character document. Literal `sheet` + `allow get` means no
    // alternate public document id and no collection enumeration. Owner writes are
    // permitted only while an atomic parent write produces the exact source snapshot
    // this projection mirrors; revoke/delete remove both sides in the same batch.
    match /users/{uid}/characters/{charId}/public/sheet {
      function parentPath() {
        return /databases/$(database)/documents/users/$(uid)/characters/$(charId);
      }
      function publishedParent() {
        return get(parentPath()).data;
      }
      function parentChangedAfter() {
        return existsAfter(parentPath())
          && (!exists(parentPath())
              || getAfter(parentPath()).data != get(parentPath()).data);
      }
      function exactPublishedSheet() {
        return exists(parentPath())
          && publishedParent().get('shared', false) == true
          && isExactPublicCharacterSheet(resource.data, publishedParent());
      }
      function exactPublishedSheetAfter() {
        return parentChangedAfter()
          && getAfter(parentPath()).data.get('shared', false) == true
          && isExactPublicCharacterSheet(
               request.resource.data,
               getAfter(parentPath()).data
             );
      }
      function parentRevokedOrDeletedAfter() {
        return exists(parentPath())
          && (!existsAfter(parentPath())
              || (getAfter(parentPath()).data != get(parentPath()).data
                  && getAfter(parentPath()).data.get('shared', false) != true));
      }
      allow get: if exactPublishedSheet();
      allow create, update: if isNotBlocked()
        && request.auth.uid == uid
        && exactPublishedSheetAfter();
      allow delete: if isNotBlocked()
        && request.auth.uid == uid
        && parentRevokedOrDeletedAfter();
    }

    // Per-character combat-state subdoc. Owners/admins keep additive-field-tolerant
    // full control: a newer client may add owner-private state without waiting for a
    // rules deploy. A current attached peer has a different, deliberately narrow
    // capability: apply reviewed table effects to HP, conditions, held inspiration,
    // death saves, the concentration-save queue, or the delivery receipt. The peer
    // patch writer does not own the retired action-revision fields, so the rules fence
    // the exact runtime roots while protecting playState, action history, round,
    // recent actions, turn economy, and every future private root byte-for-byte.
    //
    // A missing combat document fails closed: only the owner (or an admin) creates the
    // play owner, never a peer. Cross-user access derives live from the reciprocal
    // parent attachment + campaign roster; requester removal, target removal, or a
    // target character swap revokes it immediately.
    //
    // P4 deletion: `isAttachedPeer`, `peerEffectUpdate` and its validators die with the
    // encounter document.
    match /users/{uid}/characters/{charId}/combat/state {
      function parentChar() {
        return get(/databases/$(database)/documents/users/$(uid)/characters/$(charId)).data;
      }
      function parentCampaign() {
        return get(/databases/$(database)/documents/campaigns/$(parentChar().attachedCampaignId)).data;
      }
      function hasAttachedCampaign() {
        return parentChar().get("attachedCampaignId", "") != "";
      }
      function isCurrentCampaignAttachment() {
        let campaign = parentCampaign();
        return request.auth.uid in campaign.members
          && uid in campaign.members
          && campaign.get('memberDetails', {}).get(uid, {})
               .get('characterId', '') == charId;
      }
      function isAttachedPeer() {
        return request.auth.uid != uid
          && hasAttachedCampaign()
          && isCurrentCampaignAttachment();
      }
      function validPeerEffectState(data) {
        return data.hp is map
          && data.hp.keys().hasOnly(['current', 'temp'])
          && data.hp.keys().hasAll(['current', 'temp'])
          && data.hp.current is number
          && data.hp.current >= 0
          && data.hp.current <= 9007199254740991
          && data.hp.temp is number
          && data.hp.temp >= 0
          && data.hp.temp <= 9007199254740991
          && data.conditions is list
          && data.conditions.size() <= 64
          && data.deathSaves is map
          && data.deathSaves.keys().hasOnly(['successes', 'failures'])
          && data.deathSaves.keys().hasAll(['successes', 'failures'])
          && data.deathSaves.successes is int
          && data.deathSaves.successes >= 0
          && data.deathSaves.successes <= 3
          && data.deathSaves.failures is int
          && data.deathSaves.failures >= 0
          && data.deathSaves.failures <= 3
          && data.get('bardicInspirationDie', '') is string
          && data.get('heroicInspiration', false) is bool
          && (!data.keys().hasAny(['pendingConcentrationSaves'])
              || validPendingConcentrationQueue(data.pendingConcentrationSaves))
          && (!data.keys().hasAny(['appliedEncounterEffects'])
              || validAppliedEncounterEffects(data.appliedEncounterEffects))
          && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
      }
      function validPendingConcentrationQueue(queue) {
        // Rules cannot quantify over a list of maps; the defensive parser
        // validates every row and discards malformed input.
        return queue is list;
      }
      function validAppliedEncounterEffects(applied) {
        return applied is map
          && applied.keys().hasAll(['epoch', 'ids'])
          && applied.keys().hasOnly(['epoch', 'ids'])
          && applied.epoch is int
          && applied.epoch >= 0
          && applied.epoch <= 9007199254740991
          && applied.ids is list
          && applied.ids.size() == applied.ids.toSet().size();
      }
      function validPeerEncounterReceipt(applied) {
        let encounter = parentCampaign().get('encounter', null);
        return validAppliedEncounterEffects(applied)
          && encounter is map
          && encounter.get('epoch', null) == applied.epoch;
      }
      function coreConditions() {
        return [
            'blinded',
            'charmed',
            'deafened',
            'exhaustion',
            'frightened',
            'grappled',
            'incapacitated',
            'invisible',
            'paralyzed',
            'petrified',
            'poisoned',
            'prone',
            'restrained',
            'stunned',
            'unconscious'
          ].toSet();
      }
      function validPeerConditions(before, after) {
        return after is list
          && after.size() <= 64
          && after.size() == after.toSet().size()
          // Only the delta must be a closed-set core condition. An unchanged
          // preexisting custom string remains byte-preserved and cannot block a
          // legitimate peer effect on the same list.
          && after.toSet().difference(before.toSet()).hasOnly(coreConditions())
          && before.toSet().difference(after.toSet()).hasOnly(coreConditions());
      }
      function peerEffectUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return validPeerEffectState(request.resource.data)
          // A legacy/custom string condition remains parseable and must not block
          // an unrelated HP delivery. If a peer changes the root, however, the new
          // additions/removals are constrained to the closed core set Rules can
          // validate soundly.
          && (!changed.hasAny(['conditions'])
              || validPeerConditions(resource.data.conditions,
                                     request.resource.data.conditions))
          && (!changed.hasAny(['appliedEncounterEffects'])
              || validPeerEncounterReceipt(
                   request.resource.data.appliedEncounterEffects))
          && changed.hasOnly([
            'hp',
            'conditions',
            'bardicInspirationDie',
            'heroicInspiration',
            'deathSaves',
            'pendingConcentrationSaves',
            'appliedEncounterEffects',
            'updatedAt'
          ])
          && changed.hasAny([
            'hp',
            'conditions',
            'bardicInspirationDie',
            'heroicInspiration',
            'deathSaves',
            'pendingConcentrationSaves',
            'appliedEncounterEffects'
          ]);
      }
      allow read: if isNotBlocked() && (
        request.auth.uid == uid
        || isAdmin()
        || (hasAttachedCampaign() && isAttachedPeer())
      );
      allow create: if isNotBlocked() && (request.auth.uid == uid || isAdmin());
      allow update: if isNotBlocked() && (
        request.auth.uid == uid
        || isAdmin()
        || (isAttachedPeer() && peerEffectUpdate())
      );
      allow delete: if isNotBlocked() && (request.auth.uid == uid || isAdmin());
    }

    // The spends ledger (docs/architecture/2026-11-cross-device-hits.md): what a hit
    // from another device spent on the character's sheet (a ward filled, a claimed
    // dodge used up), which that device cannot write into the owner's playState. The
    // owner (or an admin) has full control and empties it as it folds; a current
    // attached peer may only APPEND: the new list starts with the old one, at most 128
    // entries. Entry shapes are read defensively by the client (`parsePeerSpends`).
    match /users/{uid}/characters/{charId}/combat/spends {
      function spendsParentChar() {
        return get(/databases/$(database)/documents/users/$(uid)/characters/$(charId)).data;
      }
      function spendsIsAttachedPeer() {
        let parent = spendsParentChar();
        let campaign = get(/databases/$(database)/documents/campaigns/$(parent.get("attachedCampaignId", ""))).data;
        return request.auth.uid != uid
          && parent.get("attachedCampaignId", "") != ""
          && request.auth.uid in campaign.members
          && uid in campaign.members
          && campaign.get('memberDetails', {}).get(uid, {}).get('characterId', '') == charId;
      }
      function peerAppendsOnly() {
        let before = resource == null ? [] : resource.data.get('entries', []);
        let after = request.resource.data.get('entries', null);
        return request.resource.data.keys().hasOnly(['entries'])
          && after is list
          && after.size() <= 128
          && after.size() > before.size()
          // A zero-length slice is an evaluation error in Rules: a new ledger
          // has nothing to keep.
          && (before.size() == 0 || after[0:before.size()] == before);
      }
      allow read: if isNotBlocked() && (
        request.auth.uid == uid || isAdmin() || spendsIsAttachedPeer()
      );
      allow create, update: if isNotBlocked() && (
        request.auth.uid == uid
        || isAdmin()
        || (spendsIsAttachedPeer() && peerAppendsOnly())
      );
      allow delete: if isNotBlocked() && (request.auth.uid == uid || isAdmin());
    }

    // Character snapshots
    match /users/{uid}/characters/{charId}/snapshots/{snapId} {
      allow read, write: if isNotBlocked() && request.auth.uid == uid;
    }

    // Private play notes (owner 2026-10-24): a note not shared with the party is
    // visible ONLY to its author, never the DM or the party (who may read the sheet
    // and its play state). Owner-only, like the snapshots.
    match /users/{uid}/characters/{charId}/privateNotes/{noteId} {
      allow read, write: if isNotBlocked() && request.auth.uid == uid;
    }

    // The account-level homebrew library (`library/index` — ONE doc holding the whole
    // `entries` list; see src/lib/library-io.ts). OWNER-ONLY, plus the free-tier cap
    // mirrored from FREE_TIER_LIMITS.libraryEntries so a direct write can't bypass it.
    // That cap is the ONLY shape assertion: the entries carry the four homebrew item
    // types (dozens of optional fields) and the client parses them defensively on read,
    // so field-locking them here would reproduce the combat-state outage class above.
    match /users/{uid}/library/{docId} {
      allow read: if isNotBlocked() && request.auth.uid == uid;
      allow write: if isNotBlocked() && request.auth.uid == uid
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 100;
    }

    // Campaigns — the enforced access matrix is exercised by
    // tests/rules/firestore-rules.test.ts (member/non-member/blocked/admin/A13/
    // list-scoped/subcollection/member-mutation). Free-tier: one doc per campaign.
    match /campaigns/{campId} {
      function isMember() {
        return isNotBlocked() && request.auth.uid in resource.data.members;
      }
      function isDm() {
        return isNotBlocked() && request.auth.uid == resource.data.dmUid;
      }

      // A regular member's update may edit shared artifacts (treasury, notes,
      // name, status) but MUST NOT change the roster or ownership.
      function rosterAndOwnerUnchanged() {
        return request.resource.data.members == resource.data.members
          && request.resource.data.memberDetails.keys().toSet()
               == resource.data.memberDetails.keys().toSet()
          && request.resource.data.dmUid == resource.data.dmUid
          && request.resource.data.createdBy == resource.data.createdBy;
      }

      // A regular member may change AT MOST their OWN memberDetails entry — never
      // another member's (the "A-edits-B" vector: rosterAndOwnerUnchanged only pins
      // the KEY SET, not which value changed, so without this a member could
      // overwrite a peer's characterId / character / role). diff().affectedKeys() at
      // the map level is the set of member uids whose VALUE changed: a self-attach
      // (setMemberCharacter) touches only the caller's uid; a shared-artifact edit
      // (treasury/notes/name/banner) touches NO memberDetails value → empty set,
      // which hasOnly() accepts. Same affectedKeys() construct proven in isSelfJoin().
      function memberEditsOnlyOwnEntry() {
        return request.resource.data.memberDetails
          .diff(resource.data.memberDetails)
          .affectedKeys()
          .hasOnly([request.auth.uid]);
      }

      // The encounter STRUCTURE is a DM tool — a regular member may NOT mutate it (it
      // touches neither the roster nor memberDetails, so the guards above would
      // otherwise let a member write it). get(...,null) so a doc WITHOUT the field
      // (the existing fixtures / pre-feature docs) still validates on both sides.
      function encounterUnchanged() {
        return request.resource.data.get('encounter', null)
          == resource.data.get('encounter', null);
      }

      // P2 — the TURN POINTER is shared: any member may advance it (the player whose PC
      // is current, or the DM), so a member's update is also allowed when the encounter
      // diff touches ONLY the two turn fields (currentCombatantId + round) — the
      // combatants array / status / membership stay byte-identical. The encounter must
      // EXIST on both sides (a member can't add/remove the encounter, only move the
      // pointer). Rules CANNOT iterate the combatants array to prove the writer IS the
      // current combatant, so this grant is intentionally coarse (any member may move
      // the pointer) and the strict who-is-current check stays UI-side — DM-correctable,
      // low-risk, per the owner mandate. Same diff().affectedKeys().hasOnly() construct
      // proven in memberEditsOnlyOwnEntry() / isSelfJoin().
      //
      // C3 — the FROZEN turn order (`encounter.order`) is DM-ONLY STRUCTURAL state: it is
      // deliberately NOT in this allow-set, so a regular member advancing the turn can
      // never freeze, drag-reorder, or otherwise rewrite the order (a diff that touches
      // `order` fails hasOnly() → the member branch denies it). Begin-turns + drag-reorder
      // therefore stay DM/admin-only by construction (the unconstrained isDm()/isAdmin()
      // update branch writes the whole encounter, `order` included) — no new write path,
      // no loosening. Pinned by the "frozen order is DM-only" rules tests.
      // A member-written round must be a whole round ≥ 1: every client's encounter
      // parse rejects anything else, which would break the fight for the whole table.
      function validEncounterRound() {
        return request.resource.data.encounter.get('round', 1) is int
          && request.resource.data.encounter.get('round', 1) >= 1;
      }
      function turnFieldsOnlyChanged() {
        return resource.data.get('encounter', null) != null
          && request.resource.data.get('encounter', null) != null
          && request.resource.data.encounter.diff(resource.data.encounter)
               .affectedKeys().hasOnly(['currentCombatantId', 'round', 'extraTurns', 'clock'])
          && validEncounterRound();
      }

      // COMBAT RESOLUTION: a player who confirms a reviewed target effect AUTO-APPLIES
      // monster damage, healing, conditions, and standing-effect operations to the
      // shared encounter, so a
      // regular member's update is ALSO allowed when the encounter diff touches ONLY
      // `combatants` (the monster HP) + `events` (the appended chronicle beats) +
      // `world` (the engine layer the adversary world seam persists in the SAME
      // transaction — the resolver's monster damage/healing now commits through the
      // deterministic engine's journal, and dropping the `world` write would strand
      // the journal behind the mirrored legacy fields) — every
      // OTHER encounter field (round · order · currentCombatantId · status · epoch) stays
      // byte-identical, so a member can never advance/rewind the fight, freeze the order,
      // or end it through this path. The encounter must EXIST on both sides (a member
      // can't conjure or clear a fight). TWO cheap structural guards keep it scoped: the
      // combatants COUNT is unchanged (no add/remove — a member only edits an existing
      // HP), the events/member-delivery arrays only GROW, and every old standing-effect
      // operation remains present in a bounded ledger (the exact inverse is another
      // operation, never a shared-snapshot restore). Like `turnFieldsOnlyChanged()` this is intentionally COARSE — the rules
      // cannot iterate the combatants array to prove ONLY scalar combat state changed, so a member
      // could in principle over-edit a monster's HP or write a corrupt `world`, which is exactly the DM-remediable,
      // low-risk case the owner's remediability mandate covers (a corrupt world FAILS
      // CLOSED at read time — `encounterWorldState` rejects it and the boundary
      // degrades to the legacy arithmetic; it can never freeze a live table). Same
      // diff().affectedKeys().hasOnly() construct proven in turnFieldsOnlyChanged().
      function combatEffectFieldsOnlyChanged() {
        return resource.data.get('encounter', null) != null
          && request.resource.data.get('encounter', null) != null
          && request.resource.data.encounter.diff(resource.data.encounter)
               .affectedKeys().hasOnly(['combatants', 'events', 'memberEffects', 'effectOps', 'currentCombatantId', 'round', 'extraTurns', 'world', 'clock'])
          && request.resource.data.encounter.combatants.size()
               == resource.data.encounter.combatants.size()
          && request.resource.data.encounter.get('events', []).size()
               >= resource.data.encounter.get('events', []).size()
          && request.resource.data.encounter.get('memberEffects', []).size()
               >= resource.data.encounter.get('memberEffects', []).size()
          && validEncounterRound()
          && validCombatEffectOpsChange();
      }

      // THE COMBAT LIFECYCLE (owner 2026-10-23, encounter-lifecycle.ts): any member starts
      // a fight with their initiative roll, joins it, passes or steps back a turn, ends it
      // and reopens it. Each move is its own narrow diff; the fight's CONTENTS (monsters,
      // HP, conditions, the frozen DM order edits) stay DM-only. An ended fight is kept
      // in `combat/ended` with `encounter` back to null, which is exactly what a v0.25.0
      // client reads after any end. The kept fight lives in its own document
      // (`combat/ended`, ruled below), so the common member write path checks nothing more
      // than before: its expression budget is spent by the effect-op batch checks.
      function keptFightPath() {
        return /databases/$(database)/documents/campaigns/$(campId)/combat/ended;
      }
      function ownPcRef(ref) {
        return ref is map
          && ref.keys().hasOnly(['kind', 'id', 'memberUid', 'characterId'])
          && ref.kind == 'pc'
          && ref.memberUid == request.auth.uid
          && ref.id == 'pc-' + request.auth.uid
          && ref.characterId is string;
      }
      // Rules cannot loop, so a list of at most 10 is checked entry by entry.
      function pcAt(list, i) {
        return list.size() <= i || (list[i] is map && list[i].get('kind', '') == 'pc');
      }
      function pcsOnly(list) {
        return pcAt(list, 0) && pcAt(list, 1) && pcAt(list, 2) && pcAt(list, 3)
          && pcAt(list, 4) && pcAt(list, 5) && pcAt(list, 6) && pcAt(list, 7)
          && pcAt(list, 8) && pcAt(list, 9);
      }
      // A roll starts a fight: a fresh one, PCs only (no monster can exist below
      // ordinal 1), round 1, and the roll table reset to the roller's own row.
      function memberStartsFight() {
        let fight = request.resource.data.get('encounter', null);
        return resource.data.get('encounter', null) == null
          && fight != null
          && fight.keys().hasOnly(['combatants', 'nextMonsterOrdinal', 'round', 'currentCombatantId', 'order', 'epoch', 'status', 'clock', 'initiatives'])
          && fight.get('initiatives', {}) is map
          && fight.nextMonsterOrdinal == 1
          && fight.round == 1
          && fight.status == 'active'
          && fight.epoch is int
          && fight.clock is map
          && fight.combatants.size() <= request.resource.data.members.size()
          && fight.combatants.size() <= 10
          && pcsOnly(fight.combatants)
          && request.resource.data.get('encounterInit', {}).keys().hasOnly([request.auth.uid])
          && request.resource.data.get('encounterSkipped', {}).keys().hasOnly([request.auth.uid]);
      }
      // A late roller joins (one own PC appended) and the order follows the rolls. Until
      // the first turn is passed in a lifecycle fight (one with a `clock`), the order
      // re-sorts: the same ids plus the joiner. Once turns have begun, or in a fight the
      // DM runs by hand (no clock), the only change is the joiner slotted in: the DM's
      // order stays and the current turn does not move.
      function lifecycleSorting(fight) {
        return fight.get('clock', null) is map
          && fight.clock.get('turnsBegun', false) == false;
      }
      function memberJoinsOrResorts() {
        let before = resource.data.get('encounter', null);
        let after = request.resource.data.get('encounter', null);
        return before != null && after != null
          && after.diff(before).affectedKeys().hasOnly(['combatants', 'order', 'currentCombatantId', 'clock', 'initiatives'])
          && after.get('initiatives', {}) is map
          && (after.combatants == before.combatants
            || (after.combatants.size() == before.combatants.size() + 1
              && after.combatants[0:before.combatants.size()] == before.combatants
              && ownPcRef(after.combatants[before.combatants.size()])))
          && (lifecycleSorting(before)
            ? (after.get('order', []).toSet().hasAll(before.get('order', []).toSet())
              && after.get('order', []).size() <= before.get('order', []).size() + 1)
            : ((before.get('order', []).hasAny(['pc-' + request.auth.uid])
                ? after.get('order', []) == before.get('order', [])
                : after.get('order', []).removeAll(['pc-' + request.auth.uid])
                  == before.get('order', []))
              && after.get('currentCombatantId', null) == before.get('currentCombatantId', null)));
      }
      // The undo of a start: a fight nobody has fought in yet (no monster, no beat, no
      // turn passed) whose only roll is the writer's own.
      function memberCancelsFight() {
        let before = resource.data.get('encounter', null);
        return before != null
          && request.resource.data.get('encounter', null) == null
          && before.nextMonsterOrdinal == 1
          && before.get('events', []).size() == 0
          && before.get('clock', {}).get('turnsBegun', false) == false
          && resource.data.get('encounterInit', {}).keys().hasOnly([request.auth.uid]);
      }
      // End: the fight moves whole into the kept-fight document in the same write,
      // stamped with why and when (that document's own rule checks the stamp).
      function memberEndsFight() {
        let before = resource.data.get('encounter', null);
        return before != null
          && request.resource.data.get('encounter', null) == null
          && existsAfter(keptFightPath())
          && getAfter(keptFightPath()).data.fight.diff(before).affectedKeys().hasOnly(['ended']);
      }
      // Reopen: the kept fight comes back and the keep empties in the same write; the
      // keep's delete rule checks that the fight is the kept one (its clock touched).
      function memberReopensFight() {
        return resource.data.get('encounter', null) == null
          && request.resource.data.get('encounter', null) != null
          && exists(keptFightPath())
          && !existsAfter(keptFightPath());
      }

      function nonEmptyEffectString(value) {
        return value is string && value.size() > 0 && value.size() <= 256;
      }

      function validCombatantRef(ref) {
        return ref is map
          && nonEmptyEffectString(ref.get('combatantId', ''))
          && (
            (ref.get('kind', '') == 'monster'
              && ref.keys().hasOnly(['kind', 'combatantId']))
            ||
            (ref.get('kind', '') == 'pc'
              && nonEmptyEffectString(ref.get('memberUid', ''))
              && nonEmptyEffectString(ref.get('characterId', ''))
              && ref.keys().hasOnly(['kind', 'combatantId', 'memberUid', 'characterId']))
          );
      }

      function validEffectDuration(effectDuration) {
        return effectDuration is map && (
          (effectDuration.get('kind', '') == 'encounter'
            && effectDuration.keys().hasOnly(['kind']))
          ||
          (effectDuration.get('kind', '') == 'concentration'
            && nonEmptyEffectString(effectDuration.get('actorId', ''))
            && nonEmptyEffectString(effectDuration.get('sourceId', ''))
            && effectDuration.keys().hasOnly(['kind', 'actorId', 'sourceId']))
          ||
          (effectDuration.get('kind', '') == 'turn-boundary'
            && nonEmptyEffectString(effectDuration.get('combatantId', ''))
            && effectDuration.get('round', -1) is number
            && effectDuration.get('phase', '') in ['turn-start', 'turn-end']
            && effectDuration.keys().hasOnly(['kind', 'combatantId', 'round', 'phase']))
        );
      }

      function validMemberApplyOperation(operation) {
        let effect = operation.get('effect', {});
        let actor = effect.get('actor', {});
        let source = effect.get('source', {});
        let payload = effect.get('payload', {});
        let bindings = effect.get('bindings', null);
        let applied = effect.get('applied', null);
        return operation is map
          && operation.keys().hasOnly(['id', 'kind', 'effect'])
          && nonEmptyEffectString(operation.get('id', ''))
          && operation.get('kind', '') == 'apply'
          && effect is map
          && effect.keys().hasOnly(['id', 'actor', 'target', 'source', 'payload', 'bindings', 'applied', 'duration'])
          && nonEmptyEffectString(effect.get('id', ''))
          && actor is map
          && actor.get('kind', '') == 'pc'
          && actor.get('memberUid', '') == request.auth.uid
          && actor.get('combatantId', '') == 'pc-' + request.auth.uid
          && validCombatantRef(actor)
          && validCombatantRef(effect.get('target', {}))
          && source is map
          && source.get('kind', '') in ['spell', 'feature']
          && nonEmptyEffectString(source.get('id', ''))
          && nonEmptyEffectString(source.get('actionId', ''))
          && source.keys().hasOnly(['kind', 'id', 'actionId', 'castLevel'])
          && payload is map
          && (
            // A spell's state, or a feature's state on its target (Stunning Strike).
            (payload.get('kind', '') == 'grant-group'
              && nonEmptyEffectString(payload.get('activeKey', ''))
              && payload.get('phase', 'active') in ['active', 'aftereffect']
              && payload.keys().hasOnly(['kind', 'activeKey', 'phase']))
            ||
            (payload.get('kind', '') == 'target-mark'
              && nonEmptyEffectString(payload.get('activeKey', ''))
              && payload.get('scope', '') in ['marked', 'cursed', 'vowed']
              && payload.keys().hasOnly(['kind', 'activeKey', 'scope']))
            ||
            (payload.get('kind', '') == 'condition'
              && nonEmptyEffectString(payload.get('conditionId', ''))
              && payload.keys().hasOnly(['kind', 'conditionId']))
            ||
            // The area a cast leaves (edge-case M9), with the creatures it spares.
            (source.get('kind', '') == 'spell'
              && payload.get('kind', '') == 'zone'
              && nonEmptyEffectString(payload.get('spellId', ''))
              && payload.get('spared', []) is list
              && payload.get('spared', []).size() <= 32
              && payload.keys().hasOnly(['kind', 'spellId', 'spared']))
          )
          && (bindings == null
            || (bindings is map
              && bindings.keys().hasOnly(['spellcastingModifier', 'saveDc'])
              && bindings.get('spellcastingModifier', 0) is number
              // The DC a repeat save is made against (edge-case M3).
              && bindings.get('saveDc', 10) is int
              && bindings.get('saveDc', 10) >= 1
              && bindings.get('saveDc', 10) <= 40))
          && (applied == null
            || (applied is map
              && applied.keys().hasOnly(['currentHpDelta'])
              && applied.get('currentHpDelta', 0) is number
              && applied.get('currentHpDelta', 0) >= -10000
              && applied.get('currentHpDelta', 0) <= 10000))
          && validEffectDuration(effect.get('duration', {}));
      }

      function validMemberRevokeOperation(operation) {
        return operation is map
          && operation.keys().hasOnly(['id', 'kind', 'effectId', 'actorId', 'targetId'])
          && nonEmptyEffectString(operation.get('id', ''))
          && operation.get('kind', '') == 'revoke'
          && nonEmptyEffectString(operation.get('effectId', ''))
          && nonEmptyEffectString(operation.get('actorId', ''))
          && nonEmptyEffectString(operation.get('targetId', ''));
      }

      // The causal inverse of a revoke (an undo): the same occurrence active again.
      function validMemberReinstateOperation(operation) {
        return operation is map
          && operation.keys().hasOnly(['id', 'kind', 'effectId', 'actorId', 'targetId'])
          && nonEmptyEffectString(operation.get('id', ''))
          && operation.get('kind', '') == 'reinstate'
          && nonEmptyEffectString(operation.get('effectId', ''))
          && nonEmptyEffectString(operation.get('actorId', ''))
          && nonEmptyEffectString(operation.get('targetId', ''));
      }

      function validMemberEffectOperation(operation) {
        return validMemberApplyOperation(operation)
          || validMemberRevokeOperation(operation)
          || validMemberReinstateOperation(operation);
      }

      // Read directly, not through get(): a missing field errors, which refuses the write
      // just the same, at a fraction of the expression budget per operation (a batch of 8
      // runs this 8 times).
      function validMemberBulkRevokeOperation(operation) {
        return operation.keys().hasOnly(['id', 'kind', 'effectId', 'actorId', 'targetId'])
          && operation.kind == 'revoke'
          && operation.id is string
          && operation.effectId is string
          && operation.actorId is string
          && operation.targetId is string;
      }

      // An end-state lifecycle pair is always `revoke + data-derived successor`. Keep
      // this narrow validator below Firestore Rules' 1000-expression ceiling; the
      // tolerant client boundary still drops malformed nested catalogue references.
      function validLifecycleSuccessorOperation(operation) {
        let effect = operation.get('effect', {});
        let source = effect.get('source', {});
        let payload = effect.get('payload', {});
        return operation is map
          && operation.keys().hasOnly(['id', 'kind', 'effect'])
          && operation.get('kind', '') == 'apply'
          && nonEmptyEffectString(operation.get('id', ''))
          && effect is map
          && nonEmptyEffectString(effect.get('id', ''))
          && validCombatantRef(effect.get('actor', {}))
          && validCombatantRef(effect.get('target', {}))
          && source is map
          && source.get('kind', '') == 'spell'
          && nonEmptyEffectString(source.get('id', ''))
          && payload is map
          && payload.get('kind', '') == 'grant-group'
          && payload.get('phase', '') == 'aftereffect'
          && validEffectDuration(effect.get('duration', {}));
      }

      // One reviewed multi-target action can consume several one-shot protections
      // (for example, multiple Death Wards) in the SAME atomic campaign update. Those
      // batches contain revokes only; support the resolver's bounded target fan-out
      // without weakening apply provenance or allowing arbitrary operation payloads.
      function validMemberRevokeBatch(after, before, start, added) {
        return (
            added == 2
            && after.removeAll([after[start], after[start + 1]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
          ) || (
            added == 3
            && after.removeAll([after[start], after[start + 1], after[start + 2]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
            && validMemberBulkRevokeOperation(after[start + 2])
          ) || (
            added == 4
            && after.removeAll([after[start], after[start + 1], after[start + 2], after[start + 3]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
            && validMemberBulkRevokeOperation(after[start + 2])
            && validMemberBulkRevokeOperation(after[start + 3])
          ) || (
            added == 5
            && after.removeAll([after[start], after[start + 1], after[start + 2], after[start + 3], after[start + 4]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
            && validMemberBulkRevokeOperation(after[start + 2])
            && validMemberBulkRevokeOperation(after[start + 3])
            && validMemberBulkRevokeOperation(after[start + 4])
          ) || (
            added == 6
            && after.removeAll([after[start], after[start + 1], after[start + 2], after[start + 3], after[start + 4], after[start + 5]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
            && validMemberBulkRevokeOperation(after[start + 2])
            && validMemberBulkRevokeOperation(after[start + 3])
            && validMemberBulkRevokeOperation(after[start + 4])
            && validMemberBulkRevokeOperation(after[start + 5])
          ) || (
            added == 7
            && after.removeAll([after[start], after[start + 1], after[start + 2], after[start + 3], after[start + 4], after[start + 5], after[start + 6]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
            && validMemberBulkRevokeOperation(after[start + 2])
            && validMemberBulkRevokeOperation(after[start + 3])
            && validMemberBulkRevokeOperation(after[start + 4])
            && validMemberBulkRevokeOperation(after[start + 5])
            && validMemberBulkRevokeOperation(after[start + 6])
          ) || (
            added == 8
            && after.removeAll([after[start], after[start + 1], after[start + 2], after[start + 3], after[start + 4], after[start + 5], after[start + 6], after[start + 7]]) == before
            && validMemberBulkRevokeOperation(after[start])
            && validMemberBulkRevokeOperation(after[start + 1])
            && validMemberBulkRevokeOperation(after[start + 2])
            && validMemberBulkRevokeOperation(after[start + 3])
            && validMemberBulkRevokeOperation(after[start + 4])
            && validMemberBulkRevokeOperation(after[start + 5])
            && validMemberBulkRevokeOperation(after[start + 6])
            && validMemberBulkRevokeOperation(after[start + 7])
          );
      }

      function validCombatEffectOpsChange() {
        let before = resource.data.encounter.get('effectOps', []);
        let after = request.resource.data.encounter.get('effectOps', []);
        let added = after.size() - before.size();
        let start = before.size();
        return after is list
          && before is list
          && after.size() <= 512
          && (
            (added == 0 && after == before)
            || (added == 1
              && after.removeAll([after[start]]) == before
              && validMemberEffectOperation(after[start]))
            || (added == 2
              && after.removeAll([after[start], after[start + 1]]) == before
              && validMemberRevokeOperation(after[start])
              && validLifecycleSuccessorOperation(after[start + 1]))
            || validMemberRevokeBatch(after, before, start, added)
          );
      }

      // INIT-SSOT — the `encounterInit` initiative table (`uid → raw d20 roll`, the
      // SIBLING of `encounter`) is the ONE home of PC initiative, and it is
      // DUAL-WRITER by design (the owner's mandate: "both should be able to edit
      // the initiative"): the DM/admin writes ANY row via the unconstrained
      // isDm()/isAdmin() branch below; a regular member may change AT MOST their
      // OWN row — the diff over the table touches only their uid (add / re-roll /
      // clear all pass; touching a peer's row fails hasOnly()). get(..., {}) so a
      // doc WITHOUT the table (pre-feature docs) validates on both sides, and a
      // shared-artifact edit that doesn't touch the table diffs to the empty set,
      // which hasOnly() accepts. Same map-diff construct proven in
      // memberEditsOnlyOwnEntry() / isSelfJoin().
      function encounterInitOwnEntryOnly() {
        return request.resource.data.get('encounterInit', {})
          .diff(resource.data.get('encounterInit', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      // ENCOUNTER PARTICIPATION — a member may opt only themselves out/in while
      // gathering. The DM/admin branch below may mark absent players when beginning
      // turns. Per-key map diffs compose and reset atomically with each encounter.
      function encounterSkippedOwnEntryOnly() {
        return request.resource.data.get('encounterSkipped', {})
          .diff(resource.data.get('encounterSkipped', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      // joinsLocked is a DM tool (the invite kill switch) — a regular member must
      // NOT flip it (it's neither roster nor memberDetails, so the guards above
      // would otherwise let a member toggle it). get(...,false) so a doc WITHOUT the
      // field (existing fixtures / pre-feature docs) validates on both sides.
      // Shared notes live in the `notes` / `dmNotes` subcollections; the legacy
      // inline `sharedNotes` array is retired (production holds none, 2026-11-03),
      // so no member or DM may write it again. The admin may still clear one.
      // The campaign clock (lib/play/campaign-clock.ts): a member moves it only forward,
      // by at most a day (one long rest's worth) per write, recording the step as theirs;
      // the step back that undoes it is the writer's or the DM's alone; setting the time
      // of day leaves the minute and the step as they were.
      function gameClockUnchanged() {
        return request.resource.data.get('gameClock', null)
          == resource.data.get('gameClock', null);
      }
      function validGameClock(clock) {
        return clock is map
          && clock.keys().hasOnly(['minute', 'timeOfDay', 'last'])
          && clock.get('minute', -1) is int
          && clock.minute >= 0
          && (!('timeOfDay' in clock)
            || (clock.timeOfDay is int && clock.timeOfDay >= 0 && clock.timeOfDay < 1440));
      }
      function gameClockWrite() {
        let before = resource.data.get('gameClock', null);
        let after = request.resource.data.get('gameClock', null);
        let from = before == null ? 0 : before.get('minute', 0);
        let last = before == null ? null : before.get('last', null);
        return gameClockUnchanged()
          || (validGameClock(after)
            && (
              // A forward step, recorded as the writer's.
              (after.minute > from
                && after.minute - from <= 1440
                && after.get('last', null) is map
                && after.last.keys().hasOnly(['by', 'minutes'])
                && after.last.get('by', '') == request.auth.uid
                && after.last.get('minutes', -1) == after.minute - from)
              ||
              // The last step taken back, by its writer or the DM.
              (last != null
                && after.minute == from - last.get('minutes', 0)
                && !('last' in after)
                && (last.get('by', '') == request.auth.uid
                  || request.auth.uid == resource.data.dmUid))
              ||
              // The time of day set, nothing else.
              (after.minute == from
                && after.get('last', null) == last)
            ));
      }

      function sharedNotesUnchanged() {
        return request.resource.data.get('sharedNotes', null)
          == resource.data.get('sharedNotes', null);
      }

      function joinsLockedUnchanged() {
        return request.resource.data.get('joinsLocked', false)
          == resource.data.get('joinsLocked', false);
      }

      // Controlled self-join: a non-member adds ONLY their own uid + their own
      // memberDetails entry, and changes nothing else. The campaign doc id == its
      // invite code, so a joiner resolves it from the code with no read access.
      // A locked campaign (joinsLocked == true) refuses ALL self-joins — the
      // no-migration kill switch for a leaked invite link. get(...,false) so a doc
      // WITHOUT the field (existing fixtures / pre-feature docs) reads as "open". A
      // non-member also must not flip the flag, so it stays UNCHANGED here; only the
      // DM toggles it (the unconstrained isDm() update branch).
      function isSelfJoin() {
        return isNotBlocked()
          && resource.data.get('joinsLocked', false) != true
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.toSet()
               == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberDetails.diff(resource.data.memberDetails)
               .affectedKeys() == [request.auth.uid].toSet()
          && request.resource.data.dmUid == resource.data.dmUid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.treasury == resource.data.treasury
          && request.resource.data.treasuryLog == resource.data.treasuryLog
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('joinsLocked', false)
               == resource.data.get('joinsLocked', false)
          && request.resource.data.get('encounterSkipped', {})
               == resource.data.get('encounterSkipped', {})
          && request.resource.data.name == resource.data.name;
      }

      // Read one campaign: members only (admin override for stats).
      allow get: if isMember() || isAdmin();
      // List: ONLY a membership-scoped query (where members array-contains uid)
      // satisfies this rule, so an unconstrained list that could surface other
      // players' campaigns is denied. Admin may enumerate (stats).
      allow list: if isAdmin()
        || (isNotBlocked() && request.auth.uid in resource.data.members);

      // A13 — creator must be a member, be recorded as createdBy, AND be the DM.
      // Without this a user could create a campaign they're locked out of, or
      // impersonate another user as creator/DM.
      allow create: if isNotBlocked()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.dmUid == request.auth.uid;

      // A member edits shared artifacts (roster + encounter frozen) AND only their
      // own member entry; the DM manages the roster + the encounter tracker; the
      // admin may write any DM-tool field; a non-member may self-join. Only the DM
      // may delete the campaign.
      // The members' combat-effect write comes first and alone: its effect-op batch check is
      // the costliest member path, and the per-request expression budget is shared by every
      // check evaluated on the way to it (measured 2026-11-02: with the effect path first and
      // the slim bulk-revoke validator, a batch of 8 revokes keeps a margin of about 30 trivial
      // checks; before, under 5). Keep new member checks OFF this path; see
      // docs/architecture/2026-11-simplify-core.md for the per-operation-document follow-up.
      allow update: if isMember() && rosterAndOwnerUnchanged() && memberEditsOnlyOwnEntry() && combatEffectFieldsOnlyChanged() && encounterInitOwnEntryOnly() && encounterSkippedOwnEntryOnly() && joinsLockedUnchanged() && gameClockUnchanged();
      allow update: if (isMember() && rosterAndOwnerUnchanged() && memberEditsOnlyOwnEntry() && (encounterUnchanged() || turnFieldsOnlyChanged() || memberJoinsOrResorts() || memberCancelsFight() || memberEndsFight() || memberReopensFight()) && encounterInitOwnEntryOnly() && encounterSkippedOwnEntryOnly() && joinsLockedUnchanged() && sharedNotesUnchanged() && gameClockWrite())
        || (isMember() && rosterAndOwnerUnchanged() && memberEditsOnlyOwnEntry() && joinsLockedUnchanged() && memberStartsFight() && sharedNotesUnchanged() && gameClockUnchanged())
        || (isDm() && sharedNotesUnchanged() && gameClockWrite())
        || isAdmin()
        || isSelfJoin();
      allow delete: if isDm();
    }

    // HIDDEN shared notes — the content-sharing SOFT-REVEAL gate, enforced by the
    // COLLECTION PATH (not a document field). A note staged hidden lives in
    // `dmNotes`, readable/writable by the DM/admin ONLY; revealing it MOVES it to the
    // members-readable `notes` collection. Path-based is the only LIST-safe gate:
    // Firestore rules are not filters, so a content-based read rule
    // (`resource.data.dmOnly != true`) would still let a member's UNSCOPED list
    // return the hidden docs — a member simply cannot read or list `dmNotes` at all.
    // A member therefore can neither read a hidden note nor author/hide one (writing
    // `dmNotes` is DM-only); the DM reveals/hides by moving the doc between the two.
    match /campaigns/{campId}/dmNotes/{noteId} {
      function dmNotesDm() {
        return isNotBlocked()
          && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campId)).data.dmUid;
      }
      allow read, write: if isAdmin() || dmNotesDm();
    }

    // M20 (docs/architecture/2026-11-dm-state-and-roster.md): an item's DM-only state
    // and what the DM has revealed of it, keyed by the physical copy's instanceId.
    // Path-gated like dmNotes (rules are not filters): a member can neither get nor
    // list `dmItems`; `itemReveals` is the members' read, the DM's write. Both are
    // excluded from the member wildcard below, or its grant would open them.
    function itemDocId(itemId) {
      return itemId.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function itemDm(campId) {
      return isNotBlocked()
        && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campId)).data.dmUid;
    }
    match /campaigns/{campId}/dmItems/{itemId} {
      allow read: if isAdmin() || itemDm(campId);
      allow write: if itemDocId(itemId) && (isAdmin() || itemDm(campId));
    }
    match /campaigns/{campId}/itemReveals/{itemId} {
      allow read: if isAdmin() || itemDm(campId)
        || (isNotBlocked()
            && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campId)).data.members);
      allow write: if itemDocId(itemId) && (isAdmin() || itemDm(campId));
    }

    // Campaign subcollections (chronicle, sessions, the REVEALED `notes`) — members
    // of the parent only. (The DM "View Sheet" feature reads the member's real
    // character doc through the live campaign-membership read grant on
    // /users/{uid}/characters/{charId} above — there is no denormalized full-sheet copy
    // subcollection to gate here.) EXCLUDES `dmNotes`: those are the
    // hidden-note collection gated DM-only ABOVE, and Firestore OR-combines matching
    // rules, so without this exclusion the broad member grant here would defeat the
    // hidden-note gate (a player could read a staged-hidden note through it).
    // The last ended fight, kept so anyone can reopen it (combat-lifecycle-io.ts). A member
    // writes it only as the other half of an end or a reopen of the campaign's fight, in
    // the same transaction; its contents are that fight exactly. The DM writes it freely.
    match /campaigns/{campId}/combat/{docId} {
      function combatCampaign() {
        return get(/databases/$(database)/documents/campaigns/$(campId)).data;
      }
      function combatCampaignAfter() {
        return getAfter(/databases/$(database)/documents/campaigns/$(campId)).data;
      }
      function combatMember() {
        return isNotBlocked() && request.auth.uid in combatCampaign().members;
      }
      function combatDm() {
        return isAdmin() || (isNotBlocked() && request.auth.uid == combatCampaign().dmUid);
      }
      function keepsTheEndedFight() {
        let fight = request.resource.data.get('fight', null);
        return docId == 'ended'
          && request.resource.data.keys().hasOnly(['fight'])
          && fight is map
          && combatCampaign().get('encounter', null) != null
          && combatCampaignAfter().get('encounter', null) == null
          && fight.diff(combatCampaign().encounter).affectedKeys().hasOnly(['ended'])
          && fight.ended.keys().hasOnly(['reason', 'at'])
          && fight.ended.reason in ['enemies-defeated', 'rest', 'idle', 'manual']
          && fight.ended.at is int;
      }
      function takesBackTheEndedFight() {
        return docId == 'ended'
          && combatCampaign().get('encounter', null) == null
          && combatCampaignAfter().get('encounter', null) != null
          && combatCampaignAfter().encounter.diff(resource.data.fight)
               .affectedKeys().hasOnly(['ended', 'clock'])
          && !('ended' in combatCampaignAfter().encounter);
      }
      allow read: if isAdmin() || combatMember();
      allow create, update: if combatDm() || (combatMember() && keepsTheEndedFight());
      allow delete: if combatDm() || (combatMember() && takesBackTheEndedFight());
    }

    // THE PARTY CHEST (Tesoro, chest-io.ts): stacks in `chest`, what waits for one
    // player's sheet in `pickups`, the item lines of «Chi ha preso cosa» in `chestLog`.
    // Any member moves things (owner 2026-11-02: loot is anyone's, always undoable); every
    // document's shape is checked, nobody writes another player's sheet.
    match /campaigns/{campId}/{chestCol}/{docId} {
      // `{chestCol}` matches every subcollection: each grant below starts with this.
      function isChest() {
        return chestCol in ['chest', 'pickups', 'chestLog'];
      }
      function chestCampaign() {
        return get(/databases/$(database)/documents/campaigns/$(campId)).data;
      }
      function chestMember() {
        return isNotBlocked() && request.auth.uid in chestCampaign().members;
      }
      function chestDm() {
        return isAdmin() || (isNotBlocked() && request.auth.uid == chestCampaign().dmUid);
      }
      function itemRef(item) {
        return item is map
          && ((item.keys().hasOnly(['srdId']) && item.srdId is string
                && item.srdId.size() > 0 && item.srdId.size() <= 80)
            || (item.keys().hasOnly(['custom', 'name']) && item.custom == true
                && item.name is string && item.name.size() > 0 && item.name.size() <= 120));
      }
      function count(n) {
        return n is int && n >= 1 && n <= 9999;
      }
      function coin(purse, unit) {
        return !(unit in purse) || (purse[unit] is int && purse[unit] >= 0 && purse[unit] <= 1000000);
      }
      function coins(purse) {
        return purse is map && purse.keys().hasOnly(['pp', 'gp', 'ep', 'sp', 'cp'])
          && coin(purse, 'pp') && coin(purse, 'gp') && coin(purse, 'ep')
          && coin(purse, 'sp') && coin(purse, 'cp');
      }
      function stamped(data) {
        return data.id == docId && data.at is int;
      }
      function validStack(data) {
        return data.keys().hasOnly(['id', 'item', 'quantity', 'note', 'addedBy', 'at'])
          && stamped(data)
          && itemRef(data.item)
          && count(data.quantity)
          && data.addedBy in chestCampaign().members
          && (!('note' in data) || (data.note is string && data.note.size() <= 500));
      }
      function validPickup(data) {
        return data.keys().hasOnly(['id', 'ownerUid', 'coins', 'item', 'quantity', 'reason', 'by', 'at'])
          && stamped(data)
          && data.by == request.auth.uid
          && data.ownerUid in chestCampaign().members
          && data.reason in ['share', 'take', 'loot']
          && (!('coins' in data) || coins(data.coins))
          && (!('item' in data) || itemRef(data.item))
          && (!('quantity' in data) || count(data.quantity))
          && ('coins' in data || 'item' in data);
      }
      function validLogLine(data) {
        return data.keys().hasOnly(['id', 'kind', 'by', 'at', 'item', 'quantity', 'coins', 'to'])
          && stamped(data)
          && data.by == request.auth.uid
          && data.kind in ['put', 'take', 'loot']
          && (!('item' in data) || itemRef(data.item))
          && (!('quantity' in data) || count(data.quantity))
          && (!('coins' in data) || coins(data.coins))
          && (!('to' in data) || data.to in ['me', 'chest', 'split']);
      }
      allow read: if isChest() && (chestMember() || isAdmin());
      allow create: if isChest() && chestMember() && (
        (chestCol == 'chest' && validStack(request.resource.data))
        || (chestCol == 'pickups' && validPickup(request.resource.data))
        || (chestCol == 'chestLog' && validLogLine(request.resource.data)));
      // A stack only changes how many are left; pickups and log lines never change.
      allow update: if isChest() && chestMember() && chestCol == 'chest'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
        && count(request.resource.data.quantity);
      allow delete: if isChest() && (chestDm() || (chestMember() && (
        chestCol == 'chest'
        || (chestCol == 'pickups'
          && (resource.data.ownerUid == request.auth.uid || resource.data.by == request.auth.uid))
        || (chestCol == 'chestLog' && resource.data.by == request.auth.uid))));
    }

    // The campaign's effects out of a fight (lib/play/campaign-effects.ts): a state one
    // creature left on another, live on the campaign clock (`game-clock`, until a
    // campaign minute), possibly held by its caster's Concentration. A member writes the
    // effects they cast (actor = their own PC); `ended` (Concentration over, or revoked)
    // is the only change, by the actor or the DM, so an undo brings the same occurrence
    // back. Excluded from the member wildcard below.
    function ceText(value) {
      return value is string && value.size() > 0 && value.size() <= 256;
    }
    function ceRef(ref) {
      return ref is map
        && ceText(ref.get('combatantId', ''))
        && (
          (ref.get('kind', '') == 'monster' && ref.keys().hasOnly(['kind', 'combatantId']))
          ||
          (ref.get('kind', '') == 'pc'
            && ceText(ref.get('memberUid', ''))
            && ceText(ref.get('characterId', ''))
            && ref.keys().hasOnly(['kind', 'combatantId', 'memberUid', 'characterId']))
        );
    }
    function ceValid(effect, effectId) {
      let source = effect.get('source', {});
      let payload = effect.get('payload', {});
      let lasts = effect.get('duration', {});
      let link = lasts.get('concentration', null);
      let bindings = effect.get('bindings', null);
      return effect.keys().hasOnly(['id', 'actor', 'target', 'source', 'payload', 'bindings', 'duration'])
        && effect.get('id', '') == effectId
        && ceRef(effect.get('actor', null))
        && ceRef(effect.get('target', null))
        && source is map
        && source.get('kind', '') in ['spell', 'feature']
        && ceText(source.get('id', ''))
        && ceText(source.get('actionId', ''))
        && source.keys().hasOnly(['kind', 'id', 'actionId', 'castLevel'])
        && (source.get('castLevel', 1) is int)
        && payload is map
        && (
          (payload.get('kind', '') == 'grant-group'
            && ceText(payload.get('activeKey', ''))
            && payload.get('phase', 'active') in ['active', 'aftereffect']
            && payload.keys().hasOnly(['kind', 'activeKey', 'phase']))
          ||
          (payload.get('kind', '') == 'target-mark'
            && ceText(payload.get('activeKey', ''))
            && payload.get('scope', '') in ['marked', 'cursed', 'vowed']
            && payload.keys().hasOnly(['kind', 'activeKey', 'scope']))
          ||
          (payload.get('kind', '') == 'condition'
            && ceText(payload.get('conditionId', ''))
            && payload.keys().hasOnly(['kind', 'conditionId']))
        )
        && (bindings == null
          || (bindings is map
            && bindings.keys().hasOnly(['spellcastingModifier', 'saveDc'])
            && bindings.get('spellcastingModifier', 0) is int
            && bindings.get('saveDc', 1) is int))
        && lasts is map
        && lasts.get('kind', '') == 'game-clock'
        && lasts.keys().hasOnly(['kind', 'untilMinute', 'concentration'])
        && lasts.get('untilMinute', -1) is int
        && lasts.untilMinute >= 0
        && (link == null
          || (link is map
            && link.keys().hasOnly(['actorId', 'sourceId'])
            && link.get('actorId', '') == effect.actor.combatantId
            && ceText(link.get('sourceId', ''))));
    }
    match /campaigns/{campId}/effects/{effectId} {
      function ceCampaign() {
        return get(/databases/$(database)/documents/campaigns/$(campId)).data;
      }
      function ceMember() {
        return isNotBlocked() && request.auth.uid in ceCampaign().members;
      }
      function ceDm() {
        return isAdmin() || (isNotBlocked() && request.auth.uid == ceCampaign().dmUid);
      }
      function ceActor(effect) {
        return effect.actor.get('memberUid', '') == request.auth.uid;
      }
      allow read: if ceDm() || ceMember();
      allow create: if (ceDm() || (ceMember() && ceActor(request.resource.data)))
        && ceValid(request.resource.data, effectId);
      allow update: if (ceDm() || (ceMember() && ceActor(resource.data)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ended'])
        && request.resource.data.get('ended', null) in [null, 'concentration', 'revoked'];
      allow delete: if ceDm() || (ceMember() && ceActor(resource.data));
    }

    match /campaigns/{campId}/{subcol}/{docId} {
      allow read, write: if subcol != 'dmNotes' && subcol != 'sessionLogs' && subcol != 'combat'
        && subcol != 'chest' && subcol != 'pickups' && subcol != 'chestLog'
        && subcol != 'dmItems' && subcol != 'itemReveals' && subcol != 'effects' && isNotBlocked()
        && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campId)).data.members;
    }

    // The session log (src/lib/session-log): one append-only document per play session.
    // The narrative overrides (hide, show, move a line) are appended items like corrections.
    // Members append exactly one item at a time, stamped with their own uid; the history
    // already written never changes, so a correction is itself an appended item. Who may
    // correct which line is decided by the deterministic fold, not here (ADR-0005: rules
    // enforce access, not gameplay). Excluded from the member wildcard above so the
    // append-only grant cannot be defeated by the broad subcollection rule.
    match /campaigns/{campId}/sessionLogs/{sessionId} {
      function campaign() {
        return get(/databases/$(database)/documents/campaigns/$(campId)).data;
      }
      function logMember() {
        return isNotBlocked() && request.auth.uid in campaign().members;
      }
      function logDm() {
        return isNotBlocked() && request.auth.uid == campaign().dmUid;
      }
      function ownItem(item) {
        return item.by == request.auth.uid
          && item.type in ['event', 'correct', 'retract', 'hide', 'show', 'move']
          && item.id is string;
      }
      function validLog() {
        return request.resource.data.schema == 1
          && request.resource.data.log is list
          && request.resource.data.log.size() <= 2000
          && request.resource.data.lastAt is int;
      }
      function newLog() {
        return request.resource.data.keys().hasOnly(['schema', 'log', 'lastAt'])
          && request.resource.data.log.size() == 1
          && ownItem(request.resource.data.log[0]);
      }
      function appendedOne() {
        let before = resource.data.log;
        let after = request.resource.data.log;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log', 'lastAt'])
          && after.size() == before.size() + 1
          && after[0:before.size()] == before
          && ownItem(after[before.size()]);
      }
      allow read: if isAdmin() || logMember();
      allow create: if logMember() && validLog() && newLog();
      // The session's own text (the Diario's «Cronaca della sessione»): any member
      // replaces it whole, last writer wins, and touches nothing else in the same write.
      function notesOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 20000;
      }
      allow update: if logMember() && ((validLog() && appendedOne()) || notesOnly());
      allow delete: if isAdmin() || logDm();

      // Phase 3b (docs/architecture/session-log-per-event.md): one document per item,
      // under the item's own id, stamped with the server's time (the read order). The
      // same append-only contract as the array: a member creates only an own item,
      // nothing is ever updated, and only the DM or the admin deletes.
      match /items/{itemId} {
        function validItem() {
          let item = request.resource.data;
          return ownItem(item)
            && item.id == itemId
            && item.at is number
            && item.serverAt == request.time
            && item.keys().hasOnly(['id', 'by', 'at', 'type', 'event', 'target', 'after', 'seen', 'serverAt'])
            // A line may carry the fight and round its device saw (SeenRound).
            && (!('seen' in item) || (item.type == 'event'
              && item.seen is map
              && item.seen.keys().hasOnly(['encounterId', 'round'])
              && item.seen.encounterId is string
              && item.seen.round is int))
            && (item.type == 'event' || item.get('target', null) is string)
            // A line or its correction carries the event; the overrides carry none.
            && (!(item.type in ['event', 'correct']) || item.get('event', null) is map)
            // Only a move names its anchor: another line's id, or null for first.
            && (item.type == 'move'
              ? ('after' in item && (item.after == null || item.after is string))
              : !('after' in item));
        }
        allow read: if isAdmin() || logMember();
        allow create: if logMember() && validItem();
        allow delete: if isAdmin() || logDm();
      }
    }

    // Bug / feature reports (OWN-37). A signed-in, non-blocked user CREATES a
    // report shaped for the onCreate Cloud Function (which runs with the Admin
    // SDK and bypasses these rules to write the issueNumber back). Reports carry a
    // debug context, so only the ADMIN may read/update/delete — the admin inbox
    // reads them and purges a report once its GitHub issue closes (the
    // reconciliation); no other client touches them.
    match /bug_reports/{id} {
      allow read:           if isAdmin();
      allow create:         if isNotBlocked()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.screen is string
        && request.resource.data.severity is string
        // Only the Cloud Function writes the issue linkage — a client-forged
        // issueNumber could point at an unrelated closed issue and get the
        // report wrongly purged by the inbox reconciliation.
        && !request.resource.data.keys().hasAny(["issueNumber", "issueUrl"]);
      allow update, delete: if isAdmin();
    }

    // Diagnostics (ADR-0008): automatic client error reports. Create-only for the
    // reporting uid with a bounded shape; the admin inbox reads and purges them.
    match /diagnostics/{id} {
      allow read, delete: if isAdmin();
      allow create: if isNotBlocked()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schema == 1
        && request.resource.data.level == "error"
        && request.resource.data.event is string
        && request.resource.data.event.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.context is map
        && request.resource.data.breadcrumbs is list
        && request.resource.data.breadcrumbs.size() <= 500
        && request.resource.data.keys().hasOnly([
          'schema','uid','level','event','message','createdAtMs','context','breadcrumbs','createdAt'
        ]);
      allow update: if false;
    }

    // Admin audit log — the `deleteUser` callable (Admin SDK, bypasses these rules)
    // writes one immutable record per destructive admin action (who deleted whom,
    // when, + the cascade counts). Admin-READABLE only; NO client may write it (the
    // function writes via the Admin SDK), so it can never be forged or tampered with
    // from a browser.
    match /admin_audit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}

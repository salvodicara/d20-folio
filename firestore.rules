rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // New Folio identity boundary. No legacy wildcard grants match these paths.
    function folioUser() { return isNotBlocked(); }
    function folioCampaign(id) { return get(/databases/$(database)/documents/folioCampaigns/$(id)).data; }
    function folioMember(id) { return folioUser() && !folioCampaign(id).archived && request.auth.uid in folioCampaign(id).members; }
    function folioDm(id) { return folioUser() && (isAdmin() || (folioMember(id) && folioCampaign(id).dmUid == request.auth.uid)); }
    function folioOwnerAccess(uid) { return folioUser() && (request.auth.uid == uid || isAdmin()); }
    function folioId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function folioClaim(a) { return a == null || (a is map && a.keys().hasOnly(['campaignId','assignmentId','version']) && folioId(a.campaignId) && folioId(a.assignmentId) && a.version is int && a.version > 0); }
    function folioReadCharacter(uid, id, c) {
      let a = c.currentAssignment;
      return folioUser() && (request.auth.uid == uid || isAdmin() ||
        (a != null && folioMember(a.campaignId) && uid in folioCampaign(a.campaignId).members
          && get(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)/roster/$(uid + '~' + id)).data
             == { 'ownerUid':uid, 'characterId':id, 'assignmentId':a.assignmentId, 'version':a.version }));
    }
    // P03: receipts are immutable and coupled to one exact version transition.
    function operationReceipt(uid, id) { return getAfter(/databases/$(database)/documents/folioAccounts/$(uid)/operations/$(id)).data; }
    function noteTransition(path, target) {
      let next = getAfter(path).data;
      let r = operationReceipt(next.lastOperation.uid, next.lastOperation.opId);
      let o = r.operation;
      return next.keys().hasOnly(['text','revision','lastOperation'])
        && next.text is string && next.text.size() <= 100000
        && next.lastOperation.keys().hasOnly(['uid','opId'])
        && next.lastOperation.uid == request.auth.uid && folioId(next.lastOperation.opId)
        && !exists(/databases/$(database)/documents/folioAccounts/$(request.auth.uid)/operations/$(next.lastOperation.opId))
        && o.kind == 'notes' && o.target == target && o.text == next.text
        && ((exists(path) && o.baseRevision == get(path).data.get('revision',0)) || (!exists(path) && o.baseRevision == 0))
        && next.revision == o.baseRevision + 1 && r.revision == next.revision;
    }
    function personalNoteAuthority(o) {
      let c = get(/databases/$(database)/documents/folioAccounts/$(o.target.ownerUid)/characters/$(o.target.characterId)).data;
      let after = getAfter(/databases/$(database)/documents/folioAccounts/$(o.target.ownerUid)/characters/$(o.target.characterId)).data;
      return folioOwnerAccess(o.target.ownerUid) && o.authority == {'characterRevision':c.revision,'assignment':c.currentAssignment,'campaignRevision':null}
        && after.revision == c.revision && after.currentAssignment == c.currentAssignment;
    }
    function dmNoteAuthority(o) {
      let c = folioCampaign(o.target.campaignId);
      return folioDm(o.target.campaignId) && o.scope.campaignId == o.target.campaignId
        && o.authority == {'characterRevision':null,'assignment':null,'campaignRevision':c.revision}
        && getAfter(/databases/$(database)/documents/folioCampaigns/$(o.target.campaignId)).data.revision == c.revision;
    }
    function assignmentOperation(o, resultRevision) {
      let path = /databases/$(database)/documents/folioAccounts/$(o.target.ownerUid)/characters/$(o.target.id);
      let before = get(path).data;
      let after = getAfter(path).data;
      let history = getAfter(/databases/$(database)/documents/folioAccounts/$(o.target.ownerUid)/characters/$(o.target.id)/history/$(string(resultRevision))).data;
      return o.target.ownerUid == request.auth.uid && o.baseRevision == before.revision
        && o.authority == {'characterRevision':before.revision,'assignment':before.currentAssignment,'campaignRevision':null}
        && after.revision == resultRevision && history.operationId == o.opId
        && ((o.campaignId == null && after.currentAssignment == null && o.campaignRevision == null)
          || (o.campaignId != null && after.currentAssignment == {'campaignId':o.campaignId,'assignmentId':o.opId,'version':resultRevision}
            && folioCampaign(o.campaignId).revision == o.campaignRevision
            && getAfter(/databases/$(database)/documents/folioCampaigns/$(o.campaignId)).data.revision == o.campaignRevision));
    }
    match /folioAccounts/{uid}/operations/{id} {
      function readable() { let o=resource.data.operation; return folioUser() && (request.auth.uid == uid || isAdmin())
        && (o.kind != 'notes' || o.target.kind == 'personal' || folioDm(o.target.campaignId)); }
      // Missing receipt lookups are necessary for idempotent transactions.
      allow get: if folioUser() && (request.auth.uid == uid || isAdmin()) && (!exists(/databases/$(database)/documents/folioAccounts/$(uid)/operations/$(id)) || readable());
      allow create: if folioUser() && request.auth.uid == uid && folioId(id)
        && request.resource.data.keys().hasOnly(['operation','revision'])
        && request.resource.data.operation.uid == uid && request.resource.data.operation.opId == id
        && request.resource.data.operation.scope.uid == uid
        && request.resource.data.operation.scope.keys().hasOnly(['uid','campaignId','activeCharacterId'])
        && request.resource.data.operation.baseRevision is int && request.resource.data.operation.baseRevision >= 0
        && request.resource.data.revision == request.resource.data.operation.baseRevision + 1
        && validOperation(request.resource.data.operation,request.resource.data.revision);
      function validOperation(o, revision) {
        return (o.kind == 'notes'
          && o.keys().hasOnly(['kind','opId','uid','scope','target','baseRevision','authority','text'])
          && ((o.target.kind == 'personal'
            && personalNoteAuthority(o)
            && getAfter(/databases/$(database)/documents/folioAccounts/$(o.target.ownerUid)/characters/$(o.target.characterId)/private/notes).data.lastOperation == {'uid':o.uid,'opId':o.opId}
            && noteTransition(/databases/$(database)/documents/folioAccounts/$(o.target.ownerUid)/characters/$(o.target.characterId)/private/notes,o.target))
            || (o.target.kind == 'dm' && dmNoteAuthority(o)
              && getAfter(/databases/$(database)/documents/folioCampaigns/$(o.target.campaignId)/dmNotes/main).data.lastOperation == {'uid':o.uid,'opId':o.opId}
              && noteTransition(/databases/$(database)/documents/folioCampaigns/$(o.target.campaignId)/dmNotes/main,o.target))))
          || (o.kind in ['library-save','library-publish','library-offer','library-accept','library-revoke'] && libraryOperation(o))
          || (o.kind in ['homebrew-add','homebrew-update','homebrew-state'] && homebrewOperation(o))
          || (o.kind == 'assignment' && o.keys().hasOnly(['kind','opId','uid','scope','target','baseRevision','authority','campaignId','campaignRevision']) && assignmentOperation(o,revision));
      }
    }
    match /folioAccounts/{uid} {
      allow get: if folioOwnerAccess(uid);
      allow list: if folioUser() && isAdmin();
      allow create, update: if folioOwnerAccess(uid)
        && request.resource.data.keys().hasOnly(['schema','displayName','locale','diceMode'])
        && request.resource.data.schema == 1 && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120 && request.resource.data.locale in ['en','it']
        && (!('diceMode' in request.resource.data) || request.resource.data.diceMode in ['digital','physical']);
    }
    match /folioAccounts/{uid}/characters/{id} {
      function owner() { return folioUser() && request.auth.uid == uid; }
      function shape(c) { return c.keys().hasOnly(['schema','ownerUid','id','name','speciesId','classId','level','revision','currentAssignment','sheet','portraitPath'])
        && c.schema == 1 && c.ownerUid == uid && c.id == id && folioId(id) && folioId(uid)
        && c.name is string && c.name.size() > 0 && c.name.size() <= 200
        && c.speciesId is string && c.classId is string && c.level is int && c.level >= 1 && c.level <= 20
        && c.revision is int && c.revision >= 0 && folioClaim(c.currentAssignment)
        && c.sheet is map && c.sheet.keys().hasOnly(['build','state']) && c.sheet.build is map && c.sheet.state is map
        && !c.sheet.build.keys().hasAny(['notes','lore','unknown','player','quote'])
        && !c.sheet.state.keys().hasAny(['notes','unknown','log'])
        && (c.portraitPath == null || (c.portraitPath is string && c.portraitPath.matches('folioAccounts/' + uid + '/characters/' + id + '/portraits/[A-Za-z0-9_.-]+'))); }
      function reciprocal(a) { return a == null ||
        (!getAfter(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)).data.archived
        && uid in getAfter(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)).data.members
        && getAfter(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)/roster/$(uid + '~' + id)).data
          == {'ownerUid':uid,'characterId':id,'assignmentId':a.assignmentId,'version':a.version}); }
      function oldClaimLive(a) { return a != null
        && exists(/databases/$(database)/documents/folioCampaigns/$(a.campaignId))
        && !getAfter(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)).data.archived
        && uid in getAfter(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)).data.members
        && exists(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)/roster/$(uid + '~' + id))
        && get(/databases/$(database)/documents/folioCampaigns/$(a.campaignId)/roster/$(uid + '~' + id)).data
          == {'ownerUid':uid,'characterId':id,'assignmentId':a.assignmentId,'version':a.version}; }
      allow get: if folioReadCharacter(uid,id,resource.data);
      allow list: if folioOwnerAccess(uid);
      allow create: if folioOwnerAccess(uid) && shape(request.resource.data) && request.resource.data.revision == 0 && request.resource.data.currentAssignment == null;
      // Assignment authority is explicitly owner-only, including administrator clients.
      allow update: if owner() && shape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision','currentAssignment'])
        && request.resource.data.revision == resource.data.revision + 1
        && operationReceipt(uid,getAfter(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)/history/$(string(request.resource.data.revision))).data.operationId).revision == request.resource.data.revision
        && (request.resource.data.currentAssignment == null ||
          (reciprocal(request.resource.data.currentAssignment)
          && request.resource.data.currentAssignment.version == request.resource.data.revision
          && !oldClaimLive(resource.data.currentAssignment)));
      // P02 has no destructive character deletion or shared sheet editor.
      match /private/{document} {
        allow read: if folioUser() && (owner() || isAdmin()) && document in ['notes','import'];
        // Legacy note initialization is limited to creating a character in this commit.
        allow create: if folioOwnerAccess(uid) && ((document == 'notes'
          && ((!exists(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id))
            && existsAfter(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id))
            && request.resource.data.keys().hasOnly(['text']) && request.resource.data.text is string && request.resource.data.text.size() <= 100000)
            || noteTransition(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)/private/notes,{'kind':'personal','ownerUid':uid,'characterId':id})))
          || (document == 'import' && request.resource.data.keys().hasOnly(['schema','original','sourceSchema']) && request.resource.data.schema == 1 && request.resource.data.sourceSchema == 3 && request.resource.data.original is string && request.resource.data.original.size() <= 750000));
        allow update: if folioOwnerAccess(uid) && document == 'notes'
          && noteTransition(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)/private/notes,{'kind':'personal','ownerUid':uid,'characterId':id});
      }
      match /history/{entry} {
        allow read: if folioUser() && (owner() || isAdmin());
        allow create: if owner() && request.resource.data.keys().hasOnly(['previous','next','revision','operationId'])
          && entry == string(request.resource.data.revision)
          && folioId(request.resource.data.operationId)
          && operationReceipt(uid,request.resource.data.operationId).operation.kind == 'assignment'
          && operationReceipt(uid,request.resource.data.operationId).operation.target == {'ownerUid':uid,'id':id}
          && request.resource.data.revision == get(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)).data.revision + 1
          && request.resource.data.revision == getAfter(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)).data.revision
          && request.resource.data.previous == get(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)).data.currentAssignment
          && request.resource.data.next == getAfter(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(id)).data.currentAssignment;
      }
    }
    match /folioCampaigns/{id} {
      function valid(c) { return c.keys().hasOnly(['schema','id','name','dmUid','members','revision','archived','joinOpen'])
        && c.schema == 1 && c.id == id && folioId(id) && folioId(c.dmUid) && c.name is string && c.name.size() > 0 && c.name.size() <= 200
        && c.members is list && c.members.size() <= 100 && c.members.toSet().size() == c.members.size() && c.dmUid in c.members
        && c.archived is bool && c.joinOpen is bool && c.revision is int && c.revision >= 0; }
      function inviteAgrees(c) { return getAfter(/databases/$(database)/documents/folioInvites/$(id)).data == {'id':id,'name':c.name,'joinOpen':c.joinOpen && !c.archived}; }
      function selfChange() { let old=resource.data; let next=request.resource.data;
        return next.diff(old).affectedKeys().hasOnly(['members','revision']) && request.auth.uid != old.dmUid
          && ((old.joinOpen && !old.archived && !(request.auth.uid in old.members) && next.members.toSet() == old.members.toSet().union([request.auth.uid].toSet()))
          || (request.auth.uid in old.members && next.members.toSet() == old.members.toSet().difference([request.auth.uid].toSet()))); }
      allow get, list: if folioUser() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if folioUser() && valid(request.resource.data) && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid] && request.resource.data.revision == 0 && inviteAgrees(request.resource.data);
      allow update: if folioUser() && valid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
        && ((folioDm(id) && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','dmUid','revision']) || inviteAgrees(request.resource.data))) || selfChange());
      match /roster/{row} {
        function rowOwner() { return folioUser() && row.matches(request.auth.uid + '~[A-Za-z0-9_-]{1,128}'); }
        function reciprocalRow(r) { let c=getAfter(/databases/$(database)/documents/folioAccounts/$(r.ownerUid)/characters/$(r.characterId)).data;
          return r.keys().hasOnly(['ownerUid','characterId','assignmentId','version']) && row == r.ownerUid + '~' + r.characterId
            && r.ownerUid == request.auth.uid && folioMember(id) && c.currentAssignment == {'campaignId':id,'assignmentId':r.assignmentId,'version':r.version}; }
        allow read: if folioMember(id) || (folioUser() && isAdmin());
        allow get: if rowOwner();
        allow create, update: if rowOwner() && reciprocalRow(request.resource.data);
        allow delete: if rowOwner() && (getAfter(/databases/$(database)/documents/folioAccounts/$(resource.data.ownerUid)/characters/$(resource.data.characterId)).data.currentAssignment == null
          || getAfter(/databases/$(database)/documents/folioAccounts/$(resource.data.ownerUid)/characters/$(resource.data.characterId)).data.currentAssignment.campaignId != id);
      }
      match /dmNotes/{document} {
        allow read: if folioUser() && (folioDm(id) || isAdmin()) && document == 'main';
        allow create, update: if folioDm(id) && document == 'main' && noteTransition(/databases/$(database)/documents/folioCampaigns/$(id)/dmNotes/main,{'kind':'dm','campaignId':id});
      }
    }
    match /folioInvites/{id} {
      allow get: if folioUser();
      allow create, update: if folioUser() && (isAdmin() || getAfter(/databases/$(database)/documents/folioCampaigns/$(id)).data.dmUid == request.auth.uid)
        && request.resource.data == {'id':id,'name':getAfter(/databases/$(database)/documents/folioCampaigns/$(id)).data.name,
          'joinOpen':getAfter(/databases/$(database)/documents/folioCampaigns/$(id)).data.joinOpen && !getAfter(/databases/$(database)/documents/folioCampaigns/$(id)).data.archived};
    }
    // P05: one character-owned instance per exact P03 receipt; no admin consent.
    function homebrewPath(o) { return /databases/$(database)/documents/folioAccounts/$(o.character.ownerUid)/characters/$(o.character.id)/homebrew/$(o.targetId); }
    function homebrewState(s) {
      return s is map && s.keys().hasOnly(['quantity','remainingCharges','prepared','equipped','attuned'])
        && s.quantity is int && s.quantity >= 0 && s.quantity <= 9007199254740991
        && (s.remainingCharges == null || (s.remainingCharges is int && s.remainingCharges >= 0 && s.remainingCharges <= 9007199254740991))
        && s.prepared is bool && s.equipped is bool && s.attuned is bool;
    }
    function homebrewAuthority(o) {
      let p=/databases/$(database)/documents/folioAccounts/$(o.character.ownerUid)/characters/$(o.character.id);
      let c=get(p).data;
      return o.character.keys().hasOnly(['ownerUid','id']) && o.character.ownerUid == request.auth.uid
        && folioId(o.character.id) && o.authority == {'characterRevision':c.revision,'assignment':c.currentAssignment,'campaignRevision':null}
        && getAfter(p).data == c;
    }
    function homebrewSource(o) {
      let v=o.snapshot;
      let p=/databases/$(database)/documents/folioAccounts/$(o.uid)/library/$(v.entryId)/versions/$(string(v.version));
      return v.ownerUid == o.uid && v.schema == 1 && v.version is int && v.version >= 1
        && v.definition.family in ['weapon','equipment','spell','feature']
        && get(p).data == v && getAfter(p).data == v;
    }
    function homebrewBase(o) {
      let p=homebrewPath(o);
      return (o.kind == 'homebrew-add' && !exists(p) && o.base == null && o.baseRevision == 0 && homebrewSource(o))
        || (o.base != null && exists(p) && o.base == get(p).data && o.baseRevision == o.base.revision
          && ((o.kind == 'homebrew-update' && o.snapshot.entryId == o.base.snapshot.entryId && o.state == o.base.state && homebrewSource(o))
            || (o.kind == 'homebrew-state' && o.snapshot == o.base.snapshot)));
    }
    function homebrewOperation(o) {
      let n=getAfter(homebrewPath(o)).data;
      return o.keys().hasOnly(['kind','opId','uid','scope','baseRevision','authority','character','targetId','base','snapshot','state'])
        && folioId(o.targetId) && o.uid == request.auth.uid && homebrewAuthority(o)
        && homebrewState(o.state) && homebrewBase(o)
        && n == {'schema':1,'id':o.targetId,'character':o.character,'revision':o.baseRevision+1,'snapshot':o.snapshot,'state':o.state,'lastOperation':{'uid':o.uid,'opId':o.opId}};
    }
    match /folioAccounts/{uid}/characters/{characterId}/homebrew/{instanceId} {
      allow read: if folioReadCharacter(uid,characterId,get(/databases/$(database)/documents/folioAccounts/$(uid)/characters/$(characterId)).data);
      function validWrite() {
        let last=request.resource.data.lastOperation;
        let r=operationReceipt(uid,last.opId);
        return folioUser() && request.auth.uid == uid && last.uid == uid && folioId(last.opId)
          && !exists(/databases/$(database)/documents/folioAccounts/$(uid)/operations/$(last.opId))
          && r.operation.uid == uid && r.operation.opId == last.opId && r.revision == r.operation.baseRevision+1
          && r.operation.kind in ['homebrew-add','homebrew-update','homebrew-state']
          && r.operation.character == {'ownerUid':uid,'id':characterId} && r.operation.targetId == instanceId
          && homebrewOperation(r.operation);
      }
      allow create,update: if validWrite();
    }
    // P04: private drafts, immutable published snapshots and recipient-owned grants.
    function libraryDefinition(d) {
      return d is map && d.keys().hasOnly(['schema','family','name','description','tags','payload'])
        && d.schema == 1 && d.family in ['weapon','equipment','spell','feature','monster','campaign-rule','species','feat','background','class','subclass']
        && d.name is string && d.name.size() <= 200 && d.description is string && d.description.size() <= 100000
        && d.tags is list && d.tags.size() <= 30 && !d.tags.hasAny([null,true,false]) && d.payload is map && d.payload.keys().hasOnly(['schema','data'])
        && d.payload.schema == 1 && d.payload.data is map && !d.payload.data.keys().hasAny(['attachments']);
    }
    function libraryHead(uid,id) {return /databases/$(database)/documents/folioAccounts/$(uid)/library/$(id);}
    function libraryOfferPath(s,id) {return /databases/$(database)/documents/folioLibraryOffers/$(id);}
    function libraryBase(o) {
      let p=libraryHead(o.uid,o.targetId);
      return (exists(p) && o.entry == get(p).data && o.baseRevision == get(p).data.revision)
        || (!exists(p) && o.entry == null && o.baseRevision == 0);
    }
    function libraryGrant(o,n) {
      let offer=o.offer;
      let path=libraryOfferPath(offer.senderUid,offer.id);
      let id=offer.senderUid+'~'+offer.id;
      let receiptPath=/databases/$(database)/documents/folioAccounts/$(o.uid)/receipts/$(id);
      return offer.schema == 2 && offer.recipientUid == o.uid && !offer.revoked && get(path).data == offer && getAfter(path).data == offer
        && !exists(receiptPath)
        && ((o.entry == null && o.targetId == id) || (o.entry != null && o.entry.provenance.source == {'ownerUid':offer.senderUid,'id':offer.sourceId}))
        && n.draft == offer.definition
        && n.provenance == {'source':{'ownerUid':offer.senderUid,'id':offer.sourceId},'sourceVersion':offer.sourceVersion,'senderUid':offer.senderUid,'offerId':offer.id,'grantId':id}
        && getAfter(receiptPath).data == {'schema':2,'senderUid':offer.senderUid,'offerId':offer.id,'recipientUid':o.uid,'sourceId':offer.sourceId,'sourceVersion':offer.sourceVersion,'entryId':o.targetId,'version':n.stableVersion,'operationId':o.opId};
    }
    function libraryVersion(o,n) {
      let v=getAfter(/databases/$(database)/documents/folioAccounts/$(o.uid)/library/$(o.targetId)/versions/$(string(n.stableVersion))).data;
      return n.stableVersion == (o.entry == null ? 0 : o.entry.stableVersion)+1 && n.draft.name.size()>0
        && !exists(/databases/$(database)/documents/folioAccounts/$(o.uid)/library/$(o.targetId)/versions/$(string(n.stableVersion)))
        && v == {'schema':1,'ownerUid':o.uid,'entryId':o.targetId,'version':n.stableVersion,'definition':n.draft,'provenance':n.provenance,'operationId':o.opId};
    }
    function libraryEntryTransition(o) {
      let n=getAfter(libraryHead(o.uid,o.targetId)).data;
      return libraryBase(o) && n.keys().hasOnly(['schema','ownerUid','id','revision','draft','stableVersion','provenance','lastOperation'])
        && n.schema == 1 && n.ownerUid == o.uid && n.id == o.targetId && n.revision == o.baseRevision+1
        && n.lastOperation == {'uid':o.uid,'opId':o.opId} && n.draft == o.definition && libraryDefinition(n.draft)
        && ((o.kind == 'library-save' && o.offer == null && n.stableVersion == (o.entry == null ? 0 : o.entry.stableVersion) && n.provenance == (o.entry == null ? null : o.entry.provenance))
        || (o.kind == 'library-publish' && o.offer == null && o.entry != null && n.draft == o.entry.draft && n.provenance == o.entry.provenance && libraryVersion(o,n)
          && (o.entry.stableVersion == 0 || get(/databases/$(database)/documents/folioAccounts/$(o.uid)/library/$(o.targetId)/versions/$(string(o.entry.stableVersion))).data.definition != n.draft))
        || (o.kind == 'library-accept' && libraryGrant(o,n) && libraryVersion(o,n)));
    }
    function libraryOfferTransition(o) {
      let p=libraryOfferPath(o.uid,o.targetId);
      let n=getAfter(p).data;
      return o.entry == null && o.definition == null && n.keys().hasOnly(['schema','senderUid','id','recipientUid','sourceId','sourceVersion','definition','revoked','revision','lastOperation'])
        && n.schema == 2 && n.senderUid == o.uid && n.id == o.targetId && folioId(n.id) && folioId(n.recipientUid)
        && libraryDefinition(n.definition) && n.lastOperation == {'uid':o.uid,'opId':o.opId} && n.revision == o.baseRevision+1
        && ((o.kind == 'library-offer' && !exists(p) && o.baseRevision == 0 && n == o.offer && !n.revoked
          && get(/databases/$(database)/documents/folioAccounts/$(o.uid)/library/$(n.sourceId)/versions/$(string(n.sourceVersion))).data.definition == n.definition)
        || (o.kind == 'library-revoke' && get(p).data == o.offer && o.offer.revision == o.baseRevision && !o.offer.revoked && n.revoked
          && n.diff(o.offer).affectedKeys().hasOnly(['revoked','revision','lastOperation'])));
    }
    function libraryOperation(o) {
      return o.keys().hasOnly(['kind','opId','uid','scope','baseRevision','authority','entry','definition','offer','targetId'])
        && o.authority == {'characterRevision':null,'assignment':null,'campaignRevision':null}
        && o.targetId is string && o.targetId.matches('^[A-Za-z0-9_~-]{1,260}$')
        && ((o.kind in ['library-save','library-publish','library-accept'] && libraryEntryTransition(o))
          || (o.kind in ['library-offer','library-revoke'] && libraryOfferTransition(o)));
    }
    function libraryWrite(uid,last) {
      let r=operationReceipt(uid,last.opId);
      return folioUser() && request.auth.uid == uid && last.uid == uid && folioId(last.opId)
        && !exists(/databases/$(database)/documents/folioAccounts/$(uid)/operations/$(last.opId))
        && r.operation.uid == uid && r.operation.opId == last.opId && r.revision == r.operation.baseRevision+1 && libraryOperation(r.operation);
    }
    match /folioAccounts/{uid}/library/{id} {
      allow get,list: if folioOwnerAccess(uid);
      allow create,update: if libraryWrite(uid,request.resource.data.lastOperation) && operationReceipt(uid,request.resource.data.lastOperation.opId).operation.targetId == id
        && operationReceipt(uid,request.resource.data.lastOperation.opId).operation.kind in ['library-save','library-publish','library-accept'];
      match /versions/{version} {
        allow get,list: if folioOwnerAccess(uid);
        allow create: if libraryWrite(uid,{'uid':uid,'opId':request.resource.data.operationId})
          && operationReceipt(uid,request.resource.data.operationId).operation.targetId == id
          && request.resource.data.entryId == id && version == string(request.resource.data.version)
          && request.resource.data.version == getAfter(libraryHead(uid,id)).data.stableVersion
          && operationReceipt(uid,request.resource.data.operationId).operation.kind in ['library-publish','library-accept'];
      }
    }
    match /folioLibraryOffers/{id} {
      allow get: if folioUser() && !exists(/databases/$(database)/documents/folioLibraryOffers/$(id));
      allow get,list: if folioUser() && (resource.data.senderUid == request.auth.uid || isAdmin() || (resource.data.recipientUid == request.auth.uid && !resource.data.revoked));
      allow create,update: if libraryWrite(request.resource.data.senderUid,request.resource.data.lastOperation) && operationReceipt(request.resource.data.senderUid,request.resource.data.lastOperation.opId).operation.targetId == id
        && operationReceipt(request.resource.data.senderUid,request.resource.data.lastOperation.opId).operation.kind in ['library-offer','library-revoke'];
    }
    // Historical P02 asset authority only. No schema-one workflow remains writable.
    match /folioAccounts/{uid}/offers/{id} {
      allow get,list: if folioOwnerAccess(uid);
    }
    match /folioAccounts/{uid}/receipts/{id} {
      allow get: if folioUser() && (request.auth.uid == uid || isAdmin() || id.matches(request.auth.uid + '~[A-Za-z0-9_-]{1,128}'));
      allow list: if folioOwnerAccess(uid);
      allow create: if libraryWrite(uid,{'uid':uid,'opId':request.resource.data.operationId})
        && operationReceipt(uid,request.resource.data.operationId).operation.kind == 'library-accept'
        && id == request.resource.data.senderUid+'~'+request.resource.data.offerId
        && id == operationReceipt(uid,request.resource.data.operationId).operation.offer.senderUid+'~'+operationReceipt(uid,request.resource.data.operationId).operation.offer.id
        && request.resource.data.entryId == operationReceipt(uid,request.resource.data.operationId).operation.targetId;
    }

    // Helper: is the request from an authenticated user?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the authenticated user not blocked?
    // Uses get() — only call this on paths where the user doc is guaranteed to exist
    // (i.e. after first sign-in completes). Do NOT use on the /users/{uid} path itself.
    function isNotBlocked() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked";
    }

    // Helper: is the user an admin? DATA-DRIVEN — reads `role: "admin"` from the
    // requester's own user doc (the SAME field the client's `useIsAdmin` reads), so
    // client + rules can't drift and no uid is hardcoded. Granted out-of-band
    // (Firestore console / an admin script); never settable by the client (update
    // is admin-only, create forbids it — see below). Assumes the user doc exists
    // (same precondition as isNotBlocked); `data.get("role", "")` treats a doc
    // without the field as simply "not admin" rather than erroring.
    function isAdmin() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin";
    }

    // The anonymous share surface is a SANITIZED, derived projection — never the
    // private character parent. Its closed schema deliberately excludes state,
    // portraitUrl, campaign attachment/invite facts, ownership markers, and every
    // future internal field unless this allowlist is consciously widened.
    function isExactPublicCharacterSheet(sheet, character) {
      return sheet is map
        && sheet.keys().hasAll([
          'publicSchema',
          'schema',
          'build',
          'cache',
          'status',
          'hasPortrait',
          'portraitCrop',
          'sourceUpdatedAt'
        ])
        && sheet.keys().hasOnly([
          'publicSchema',
          'schema',
          'build',
          'cache',
          'status',
          'hasPortrait',
          'portraitCrop',
          'sourceUpdatedAt'
        ])
        && sheet.publicSchema == 1
        && sheet.schema == 3
        && character.schema == 3
        && character.state is map
        && character.state.size() == 0
        && sheet.build == character.build
        && sheet.cache == character.cache
        && sheet.status == character.status
        && sheet.status in ['active', 'retired', 'dead', 'archived']
        && sheet.hasPortrait
             == (character.get('portraitUrl', '') is string
                 && character.get('portraitUrl', '').size() > 0)
        && sheet.portraitCrop
             == (sheet.hasPortrait ? character.get('portraitCrop', null) : null)
        && character.updatedAt is timestamp
        && sheet.sourceUpdatedAt is timestamp
        && sheet.sourceUpdatedAt == character.updatedAt;
    }

    // Users collection
    // - Read own doc: only auth required (no get() loop)
    // - Create own doc: first sign-in bootstrap — but MUST NOT self-assign the
    //   admin role (that's the self-promotion vector; admin is granted out-of-band)
    // - Update: ADMIN (full — block/unblock, grant role) OR the owner's OWN
    //   telemetry-only self-update (the recurring `lastActiveAt` sign-in bump in
    //   `src/lib/auth.ts`). A non-admin may touch ONLY their own `lastActiveAt` and
    //   NOTHING else — never `role` (the role-escalation vector) and never `status`
    //   (the self-UNBLOCK vector). The field-lock uses the SAME
    //   diff().affectedKeys().hasOnly() construct proven in the campaign rules. A
    //   non-admin still cannot touch ANOTHER user's doc (the request.auth.uid == uid
    //   guard). Before this, `update` was admin-only, so a normal user's recurring
    //   lastActiveAt write was silently DENIED (it only ever landed for admins) —
    //   this fixes that latent gap while keeping role/status admin-only.
    // - List: admin only
    match /users/{uid} {
      // A non-admin may update ONLY their own doc and ONLY the `lastActiveAt`
      // telemetry field — defined INSIDE the match so the `{uid}` wildcard is in
      // scope. Same diff().affectedKeys().hasOnly() construct proven in the
      // campaign rules.
      function isSelfTelemetryUpdate() {
        return request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActiveAt"]);
      }
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.get("role", "") != "admin";
      allow update: if isAdmin() || isSelfTelemetryUpdate();
      allow list:   if isAdmin();
    }

    // Characters — the OWNER (and the admin) write; a current co-member READS.
    //
    // CROSS-USER ACCESS IS DERIVED LIVE — THE SINGLE SOURCE OF TRUTH IS THE CAMPAIGN
    // DOC. The character carries ONE pointer, `attachedCampaignId`; the grant is "the
    // requester AND the target owner are CURRENT members of THAT campaign, whose
    // target roster row names this exact character", read live off the campaign doc
    // here. There is NO stored reader list to recompute or go stale, so a DM transfer
    // or a roster change is effective on the very next request. Sheets are open to the
    // team: secrecy is DM-vs-players, never player-vs-player.
    //
    // NOBODY but the owner (or the admin) WRITES here. The DM detach exception is GONE
    // (§5.2: a membership operation never writes another user's documents — the
    // owner's own client clears its own claim). ADMIN-SUPREME (owner decision
    // 2026-09-03): `users/{uid}.role == "admin"` carries owner-level rights on every
    // user path, under the SAME invariants — the revision compare-and-set, the empty
    // parent state, and the exact public projection.
    //
    // PUBLIC SHARE LINKS never expose this private parent. Anonymous GET lives at
    // the closed `public/sheet` projection below. Parent + projection are one atomic
    // publication invariant: shared=true requires an exact projection after every
    // write; shared=false/deletion requires its absence.
    match /users/{uid}/characters/{charId} {
      // The campaign this character claims attachment to. Only evaluated AFTER the
      // has-a-claim guard below; a dangling claim (campaign deleted) errors the
      // get() → the branch denies, which is the correct fail-closed behaviour.
      function attachedCampaign() {
        return get(/databases/$(database)/documents/campaigns/$(resource.data.attachedCampaignId)).data;
      }
      // A campaign roster entry is the reciprocal half of attachment. The parent
      // pointer alone is only a claim: stale data must not keep granting the table
      // access after this character's owner is removed or attaches another char.
      function isCurrentCampaignAttachment() {
        let campaign = attachedCampaign();
        return request.auth.uid in campaign.members
          && uid in campaign.members
          && campaign.get('memberDetails', {}).get(uid, {})
               .get('characterId', '') == charId;
      }
      function isOwnerOrAdmin() {
        return isNotBlocked() && (request.auth.uid == uid || isAdmin());
      }
      allow read: if isOwnerOrAdmin()
        || (isNotBlocked()
            && resource.data.get("attachedCampaignId", "") != ""
            && isCurrentCampaignAttachment());
      function publicSheetMatchesAfter() {
        let sheetPath = /databases/$(database)/documents/users/$(uid)/characters/$(charId)/public/sheet;
        return (request.resource.data.get('shared', false) == true
                && existsAfter(sheetPath)
                && isExactPublicCharacterSheet(
                     getAfter(sheetPath).data,
                     request.resource.data
                   ))
          || (request.resource.data.get('shared', false) != true
              && !existsAfter(sheetPath));
      }
      // The parent never carries a play session: the play owner is combat/state.
      function parentStateEmptyAfter() {
        return request.resource.data.state is map
          && request.resource.data.state.size() == 0;
      }
      // The parent build write is compare-and-set on `revision` (design §5.3).
      // A build/state/cache change REQUIRES exactly resource.revision + 1. Anything
      // else may leave `revision` untouched OR advance it by exactly one: the sharing
      // publish and the snapshot restore rewrite the WHOLE parent with values that
      // often diff to nothing, yet are ordinary generation-advancing writes. `+2` and
      // any stale value are always denied. Offline writes queue and are rejected on
      // reconnect when stale, which the client surfaces as a save error.
      function revisionAdvancesWithBuild() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return request.resource.data.revision is int
          && (request.resource.data.revision == resource.data.revision + 1
              || (!changed.hasAny(['build', 'state', 'cache'])
                  && request.resource.data.revision == resource.data.revision));
      }
      allow create: if isOwnerOrAdmin()
        && request.resource.data.revision == 0
        && parentStateEmptyAfter()
        && publicSheetMatchesAfter();
      allow update: if isOwnerOrAdmin()
        && revisionAdvancesWithBuild()
        && parentStateEmptyAfter()
        && publicSheetMatchesAfter();
      allow delete: if isOwnerOrAdmin()
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/$(charId)/public/sheet);
    }

    // The ONE anonymous character document. Literal `sheet` + `allow get` means no
    // alternate public document id and no collection enumeration. Owner writes are
    // permitted only while an atomic parent write produces the exact source snapshot
    // this projection mirrors; revoke/delete remove both sides in the same batch.
    match /users/{uid}/characters/{charId}/public/sheet {
      function parentPath() {
        return /databases/$(database)/documents/users/$(uid)/characters/$(charId);
      }
      function publishedParent() {
        return get(parentPath()).data;
      }
      function parentChangedAfter() {
        return existsAfter(parentPath())
          && (!exists(parentPath())
              || getAfter(parentPath()).data != get(parentPath()).data);
      }
      function exactPublishedSheet() {
        return exists(parentPath())
          && publishedParent().get('shared', false) == true
          && isExactPublicCharacterSheet(resource.data, publishedParent());
      }
      function exactPublishedSheetAfter() {
        return parentChangedAfter()
          && getAfter(parentPath()).data.get('shared', false) == true
          && isExactPublicCharacterSheet(
               request.resource.data,
               getAfter(parentPath()).data
             );
      }
      function parentRevokedOrDeletedAfter() {
        return exists(parentPath())
          && (!existsAfter(parentPath())
              || (getAfter(parentPath()).data != get(parentPath()).data
                  && getAfter(parentPath()).data.get('shared', false) != true));
      }
      allow get: if exactPublishedSheet();
      allow create, update: if isNotBlocked()
        && request.auth.uid == uid
        && exactPublishedSheetAfter();
      allow delete: if isNotBlocked()
        && request.auth.uid == uid
        && parentRevokedOrDeletedAfter();
    }

    // The personal encounter (`combat/state`) — an OWNER document: the owner (and the
    // admin) write it, a current co-member READS it, nobody else touches it. There is
    // deliberately NO shape here: the codec is the shape (a rules field-lock caused the
    // "initiative never saves" outage when the deployed rules lagged the client by one
    // field), and there is no peer write fence any more — a table effect is an ACTION
    // appended to `campaigns/{campId}/encounters/{eid}` (§5.1) that the reducer folds,
    // never a cross-user write.
    //
    // The cross-user READ derives live from the reciprocal parent attachment + campaign
    // roster; requester removal, target removal, or a target character swap revokes it
    // on the very next request, and a parent without a claim fails closed.
    match /users/{uid}/characters/{charId}/combat/state {
      function parentChar() {
        return get(/databases/$(database)/documents/users/$(uid)/characters/$(charId)).data;
      }
      function isCoMember() {
        let campaign = get(/databases/$(database)/documents/campaigns/$(parentChar().attachedCampaignId)).data;
        return request.auth.uid in campaign.members
          && uid in campaign.members
          && campaign.get('memberDetails', {}).get(uid, {}).get('characterId', '') == charId;
      }
      allow read: if isNotBlocked() && (
        request.auth.uid == uid
        || isAdmin()
        || (parentChar().get("attachedCampaignId", "") != "" && isCoMember()));
      allow write: if isNotBlocked() && (request.auth.uid == uid || isAdmin());
    }

    // Character snapshots are IMMUTABLE envelopes: created and deleted by the owner
    // (or the admin), never updated. The shape is the unified codec envelope
    // (`{ schema, build, state }` — the ONE format the parent doc and the export also
    // use) plus the reason the snapshot was taken.
    match /users/{uid}/characters/{charId}/snapshots/{snapId} {
      allow read, delete: if isNotBlocked() && (request.auth.uid == uid || isAdmin());
      allow create: if isNotBlocked() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.schema == 3
        && request.resource.data.build is map
        && request.resource.data.state is map
        && request.resource.data.reason is string;
      allow update: if false;
    }

    // The account-level homebrew library (`library/index` — ONE doc holding the whole
    // `entries` list; see src/lib/library-io.ts). OWNER (or admin) only, plus the
    // free-tier cap mirrored from FREE_TIER_LIMITS.libraryEntries so a direct write
    // can't bypass it. That cap is the ONLY shape assertion: the entries carry the four
    // homebrew item types (dozens of optional fields) and the client parses them
    // defensively on read, so field-locking them here would reproduce the combat-state
    // outage class above.
    match /users/{uid}/library/{docId} {
      allow read: if isNotBlocked() && (request.auth.uid == uid || isAdmin());
      allow write: if isNotBlocked() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 100;
    }

    // Campaigns — IDENTITY, settings, treasury and roster; nothing else. The model's
    // fields are ENUMERATED, so a write may neither create nor change anything outside
    // them: the embedded `encounter`, `encounterInit`, `encounterSkipped`,
    // `memberEffects`, `effectOps` and `world` are GONE — play lives in the shared
    // `encounters/{eid}` document (§5.4), and no rule here reads a game field any more.
    // `sharedNotes` survives only as the legacy read-fallback a member may delete.
    // The enforced matrix is exercised by tests/rules/firestore-rules.test.ts
    // (member/non-member/blocked/admin/A13/list-scoped/member-mutation/self-join).
    match /campaigns/{campId} {
      function isMember() {
        return isNotBlocked() && request.auth.uid in resource.data.members;
      }
      function isDm() {
        return isNotBlocked() && request.auth.uid == resource.data.dmUid;
      }

      // EVERY key a live writer may persist (src/features/campaigns/campaign-io.ts +
      // CampaignDoc). A key absent from this list is writable by NOBODY — member, DM
      // or admin — which is what retires the deleted play fields without a migration.
      function modelFields() {
        return ['name', 'createdAt', 'updatedAt', 'createdBy', 'dmUid', 'members', 'memberDetails',
                'status', 'inviteCode', 'treasury', 'treasuryLog', 'bannerUrl', 'bannerCrop',
                'joinsLocked', 'sharedNotes'];
      }
      function touchesOnlyModelFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(modelFields());
      }

      // A table always has a DM sitting at it: a transfer to a non-member would strand
      // the campaign's DM tools with nobody able to use them.
      function dmIsMember() {
        return request.resource.data.dmUid in request.resource.data.members;
      }

      // A regular member's update may edit shared artifacts (treasury, notes,
      // name, status) but MUST NOT change the roster or ownership.
      function rosterAndOwnerUnchanged() {
        return request.resource.data.members == resource.data.members
          && request.resource.data.memberDetails.keys().toSet()
               == resource.data.memberDetails.keys().toSet()
          && request.resource.data.dmUid == resource.data.dmUid
          && request.resource.data.createdBy == resource.data.createdBy;
      }

      // A regular member may change AT MOST their OWN memberDetails entry — never
      // another member's (the "A-edits-B" vector: rosterAndOwnerUnchanged only pins
      // the KEY SET, not which value changed, so without this a member could
      // overwrite a peer's characterId / character / role). diff().affectedKeys() at
      // the map level is the set of member uids whose VALUE changed: a self-attach
      // (setMemberCharacter) touches only the caller's uid; a shared-artifact edit
      // (treasury/notes/name/banner) touches NO memberDetails value → empty set,
      // which hasOnly() accepts. Same affectedKeys() construct proven in isSelfJoin().
      function memberEditsOnlyOwnEntry() {
        return request.resource.data.memberDetails
          .diff(resource.data.memberDetails)
          .affectedKeys()
          .hasOnly([request.auth.uid]);
      }

      // joinsLocked is a DM tool (the invite kill switch) — a regular member must
      // NOT flip it (it's neither roster nor memberDetails, so the guards above
      // would otherwise let a member toggle it). get(...,false) so a doc WITHOUT the
      // field (existing fixtures / pre-feature docs) validates on both sides.
      function joinsLockedUnchanged() {
        return request.resource.data.get('joinsLocked', false)
          == resource.data.get('joinsLocked', false);
      }

      // Controlled self-join: a non-member adds ONLY their own uid + their own
      // memberDetails entry, and changes nothing else. The campaign doc id == its
      // invite code, so a joiner resolves it from the code with no read access.
      // A locked campaign (joinsLocked == true) refuses ALL self-joins — the
      // no-migration kill switch for a leaked invite link. get(...,false) so a doc
      // WITHOUT the field (existing fixtures / pre-feature docs) reads as "open". A
      // non-member also must not flip the flag, so it stays UNCHANGED here; only the
      // DM toggles it (the unconstrained isDm() update branch). The banner is pinned
      // the same way (get(..., null) on both sides, so a doc without the field
      // validates): touchesOnlyModelFields() would otherwise let a joiner repaint the
      // campaign on the way in.
      function isSelfJoin() {
        return isNotBlocked()
          && resource.data.get('joinsLocked', false) != true
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.toSet()
               == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberDetails.diff(resource.data.memberDetails)
               .affectedKeys() == [request.auth.uid].toSet()
          && request.resource.data.dmUid == resource.data.dmUid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.treasury == resource.data.treasury
          && request.resource.data.treasuryLog == resource.data.treasuryLog
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('joinsLocked', false)
               == resource.data.get('joinsLocked', false)
          && request.resource.data.get('bannerUrl', null)
               == resource.data.get('bannerUrl', null)
          && request.resource.data.get('bannerCrop', null)
               == resource.data.get('bannerCrop', null)
          && request.resource.data.name == resource.data.name;
      }

      // Read one campaign: members only (admin override for stats).
      allow get: if isMember() || isAdmin();
      // List: ONLY a membership-scoped query (where members array-contains uid)
      // satisfies this rule, so an unconstrained list that could surface other
      // players' campaigns is denied. Admin may enumerate (stats).
      allow list: if isAdmin()
        || (isNotBlocked() && request.auth.uid in resource.data.members);

      // A13 — creator must be a member, be recorded as createdBy, AND be the DM.
      // Without this a user could create a campaign they're locked out of, or
      // impersonate another user as creator/DM. The closed key set means a create
      // cannot smuggle a field the model does not own.
      allow create: if isNotBlocked()
        && request.resource.data.keys().hasOnly(modelFields())
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.dmUid == request.auth.uid;

      // A member edits shared artifacts and only their own member entry; the DM
      // manages the roster and the settings; the admin may write any of it; a
      // non-member may self-join. Every branch is confined to the model's fields and
      // must leave a DM sitting at the table.
      allow update: if touchesOnlyModelFields() && dmIsMember()
        && ((isMember() && rosterAndOwnerUnchanged() && memberEditsOnlyOwnEntry() && joinsLockedUnchanged())
            || isDm() || isAdmin() || isSelfJoin());
      allow delete: if isDm() || isAdmin();
    }

    // HIDDEN shared notes — the content-sharing SOFT-REVEAL gate, enforced by the
    // COLLECTION PATH (not a document field). A note staged hidden lives in
    // `dmNotes`, readable/writable by the DM/admin ONLY; revealing it MOVES it to the
    // members-readable `notes` collection. Path-based is the only LIST-safe gate:
    // Firestore rules are not filters, so a content-based read rule
    // (`resource.data.dmOnly != true`) would still let a member's UNSCOPED list
    // return the hidden docs — a member simply cannot read or list `dmNotes` at all.
    // A member therefore can neither read a hidden note nor author/hide one (writing
    // `dmNotes` is DM-only); the DM reveals/hides by moving the doc between the two.
    match /campaigns/{campId}/dmNotes/{noteId} {
      function dmNotesDm() {
        return isNotBlocked()
          && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campId)).data.dmUid;
      }
      allow read, write: if isAdmin() || dmNotesDm();
    }

    // Campaign subcollections (chronicle, sessions, the REVEALED `notes`) — members
    // of the parent only. (The DM "View Sheet" feature reads the member's real
    // character doc through the live roster grant above — there is no denormalized
    // full-sheet copy subcollection to gate here.) EXCLUDES `dmNotes`: those are the
    // hidden-note collection gated DM-only ABOVE, and Firestore OR-combines matching
    // rules, so without this exclusion the broad member grant here would defeat the
    // hidden-note gate (a player could read a staged-hidden note through it).
    match /campaigns/{campId}/{subcol}/{docId} {
      allow read, write: if subcol != 'dmNotes' && subcol != 'encounters' && isNotBlocked()
        && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campId)).data.members;
    }

    // The encounter document (combat re-architecture, P2 prototype — ADR-0002/0005).
    // The ONLY shared writable gameplay surface of the target architecture. Members
    // APPEND actions to `log` (the array only grows; nothing else changes); the DM and
    // the admin may create, checkpoint (rewrite) and delete. Rules enforce membership
    // and shape; game legality is the reducer's job (`src/lib/combat`). This block is
    // deliberately excluded from the member wildcard above so the append-only grant
    // cannot be defeated by the broad subcollection rule.
    match /campaigns/{campId}/encounters/{eid} {
      function campaign() {
        return get(/databases/$(database)/documents/campaigns/$(campId)).data;
      }
      function encounterMember() {
        return isNotBlocked() && request.auth.uid in campaign().members;
      }
      function encounterDm() {
        return isNotBlocked() && request.auth.uid == campaign().dmUid;
      }
      // The log cap is the CODEC's real ceiling expressed in rules, not the codec's
      // 2,048-entry collection limit. `exact-schema` also caps a parsed document at
      // 50,000 JSON NODES counted over the log AND the checkpoint together
      // (`MAX_VALUES`), and a realistic action is ~21 nodes (~34 for the fattest
      // intent the prototype writes). 1,000 entries is ~21,000-34,000 nodes — inside
      // the budget, and still 5x the design §5.3 compaction trigger of 200. A larger
      // cap would admit a document that quarantines on EVERY client, and
      // `checkpointEncounter` refuses to rewrite a quarantined document, so compaction
      // — the only repair — is exactly what would stop working.
      function validEncounterShape() {
        return request.resource.data.schema == 1
          && request.resource.data.log is list
          && request.resource.data.log.size() <= 1000;
      }
      // APPEND-ONLY, not merely LONGER. A size comparison alone would let a member
      // rewrite every stored entry as long as the list ended up one row longer — a
      // silent rewrite of the DM's and the peers' history that the fold would trust.
      // The stored log must remain a PREFIX of the written one, so existing rows are
      // byte-frozen (lists compare by deep equality) and only the tail may grow.
      // The empty stored log is guarded EXPLICITLY, not for elegance: `l[0:0]` is an
      // EVALUATION ERROR in the rules language ("Index out of bound … Index: [-1]"),
      // not an empty list, so without the guard a member's append is denied outright
      // whenever the log is empty — which is precisely the state a checkpoint leaves
      // behind once the grace window has passed (a quiet table, then the next player
      // action), and the state a DM's freshly opened empty encounter starts in. An
      // empty stored log is trivially a prefix of anything, so the guard weakens the
      // fence by nothing. Proven by tests/rules/encounter-two-clients.emulator.test.ts
      // (the leased PC leaves the table across the compaction boundary).
      function logOnlyGrew() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log'])
          && request.resource.data.log.size() > resource.data.log.size()
          && (resource.data.log.size() == 0
              || request.resource.data.log[0:resource.data.log.size()] == resource.data.log);
      }
      allow read: if isAdmin() || encounterMember();
      allow create: if (isAdmin() || encounterDm()) && validEncounterShape();
      allow update: if validEncounterShape()
        && ((isAdmin() || encounterDm()) || (encounterMember() && logOnlyGrew()));
      allow delete: if isAdmin() || encounterDm();
    }

    // Bug / feature reports (OWN-37). A signed-in, non-blocked user CREATES a
    // report shaped for the onCreate Cloud Function (which runs with the Admin
    // SDK and bypasses these rules to write the issueNumber back). Reports carry a
    // debug context, so only the ADMIN may read/update/delete — the admin inbox
    // reads them and purges a report once its GitHub issue closes (the
    // reconciliation); no other client touches them.
    match /bug_reports/{id} {
      allow read:           if isAdmin();
      allow create:         if isNotBlocked()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.screen is string
        && request.resource.data.severity is string
        // Only the Cloud Function writes the issue linkage — a client-forged
        // issueNumber could point at an unrelated closed issue and get the
        // report wrongly purged by the inbox reconciliation.
        && !request.resource.data.keys().hasAny(["issueNumber", "issueUrl"]);
      allow update, delete: if isAdmin();
    }

    // Diagnostics (ADR-0008): automatic client error reports. Create-only for the
    // reporting uid with a bounded shape; the admin inbox reads and purges them.
    match /diagnostics/{id} {
      allow read, delete: if isAdmin();
      allow create: if isNotBlocked()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schema == 1
        && request.resource.data.level == "error"
        && request.resource.data.event is string
        && request.resource.data.event.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.context is map
        && request.resource.data.breadcrumbs is list
        && request.resource.data.breadcrumbs.size() <= 500
        && request.resource.data.keys().hasOnly([
          'schema','uid','level','event','message','createdAtMs','context','breadcrumbs','createdAt'
        ]);
      allow update: if false;
    }

    // Admin audit log — the `deleteUser` callable (Admin SDK, bypasses these rules)
    // writes one immutable record per destructive admin action (who deleted whom,
    // when, + the cascade counts). Admin-READABLE only; NO client may write it (the
    // function writes via the Admin SDK), so it can never be forged or tampered with
    // from a browser.
    match /admin_audit/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}

  "cards": [
    {
      "dot": "emerald",
      "title": "One writable fact",
      "items": [
        "The only persisted mutation is an Action appended to the log",
        "resolve(state, action, catalogue) is pure: no clock, no randomness, no locale",
        "Receipts are recomputed on every fold, never stored"
      ]
    },
    {
      "dot": "rose",
      "title": "Dice never bypass the log",
      "items": [
        "src/lib/dice.ts is the only module that draws randomness for a roll",
        "An app roll stores its seed so any client can verify the faces; a manual roll stores the read faces",
        "A roll is consumed by at most one action, and by the entity it was rolled for"
      ]
    },
    {
      "dot": "orange",
      "title": "Correction and compaction",
      "items": [
        "Undo is a fold-level fact: the undone action and its dependents are skipped",
        "Compaction folds the head into a checkpoint and drops it from the log",
        "An action swallowed by a checkpoint can no longer be undone"
      ]
    }
  ]

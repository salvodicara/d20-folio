  "cards": [
    {
      "dot": "emerald",
      "title": "One atomic creation",
      "items": [
        "createCreationRepository writes five documents in a single Firestore transaction",
        "The character parent starts at revision 0, each acquisition aggregate at revision 1",
        "A recovered operation can only inspect its exact receipt, so a retry never duplicates a character"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sources are pinned",
      "items": [
        "Every selection carries the definition snapshot it was made from",
        "The transaction re-reads each library version and refuses when the stored bytes differ",
        "A snapshot owned by another account is refused outright"
      ]
    },
    {
      "dot": "rose",
      "title": "Import is a review, not a copy",
      "items": [
        "The analysis classifies the declared edition and every mechanical path it recognises",
        "A field is reconciled by a person before it can enter an authorized sheet",
        "Codecs preserve unknown keys verbatim so a future document round-trips byte for byte"
      ]
    }
  ]

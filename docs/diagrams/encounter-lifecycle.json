  "cards": [
    {
      "dot": "emerald",
      "title": "The phases the code defines",
      "items": [
        "Clock.phase is idle, gathering, turns or ended — there is no paused or draft state",
        "table:start is refused unless the phase is idle or ended; table:begin-turns unless it is gathering",
        "table:end has no phase guard and clears every open window"
      ]
    },
    {
      "dot": "cyan",
      "title": "What a turn holds",
      "items": [
        "A declared attack waits in a reaction window while an eligible creature still has its reaction",
        "A pending concentration check waits in checks[] until a check action settles it",
        "Ending a turn resets the ledger, advances the round when the order wraps, and skips the dead"
      ]
    },
    {
      "dot": "orange",
      "title": "Correction and compaction",
      "items": [
        "Every correction is an appended action, so every client reaches the same state",
        "Compaction folds the head into a checkpoint and drops those actions from the document",
        "Redo across a checkpoint is impossible: the target is no longer in the log"
      ]
    }
  ]

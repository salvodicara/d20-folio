  "cards": [
    {
      "dot": "emerald",
      "title": "Dependency direction",
      "items": [
        "data, types, stores and lib point into views, then into features and UI, never backwards",
        "src/lib/views is the only engine-side layer allowed to localize, and its translator is a parameter",
        "src/lib/combat holds no clock, no randomness and no Firebase handle"
      ]
    },
    {
      "dot": "cyan",
      "title": "Shared play",
      "items": [
        "One live table per campaign at campaigns/{id}/encounters/live",
        "Actions are appended with arrayUnion and ordered by a hybrid logical clock",
        "Every client folds the same log to the same state"
      ]
    },
    {
      "dot": "rose",
      "title": "Licensing partition",
      "items": [
        "src/data and src/i18n/*/srd carry SRD 5.2.1 content only",
        "The private pack mounts through the same seam and is swapped for an empty module in the SRD-only build",
        "Rules authorize access; they never decide gameplay"
      ]
    }
  ]

  "cards": [
    {
      "dot": "emerald",
      "title": "One shared document",
      "items": [
        "Every client appends to the same log with arrayUnion; nobody writes a peer's document",
        "The hybrid logical clock, not arrival order, decides how the log folds",
        "The reaction window is computed by the reducer from data, never sent as a message"
      ]
    },
    {
      "dot": "cyan",
      "title": "Automation levels",
      "items": [
        "The DM picks full-auto, propose-and-confirm or log-only per campaign (ADR-0011)",
        "The reducer computes the same receipt at every level; the level decides whether it is applied",
        "propose-and-confirm is declared in the types and still rejected by the reducer today"
      ]
    },
    {
      "dot": "rose",
      "title": "The DM keeps the last word",
      "items": [
        "override sets a value with a reason; undo removes an action from the fold",
        "Both are ordinary log actions, visible to every seat",
        "A checkpoint bounds how far back undo can reach"
      ]
    }
  ]

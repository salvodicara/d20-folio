rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin is DATA-DRIVEN — the SAME `/users/{uid}.role == "admin"` field the
    // client gate (`useIsAdmin`) and `firestore.rules` (`isAdmin()`) read, via
    // the cross-service Firestore lookup, so no uid is ever hardcoded here and
    // the three gates can't drift.
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin";
    }

    match /users/{uid}/portraits/{fileName} {
      allow read: if request.auth != null;
      // create/update: validate size + mime type (request.resource is defined)
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // delete: no request.resource — only check auth
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // N4 — campaign banner: any authenticated user may read/write a campaign's
    // banner. The {campaignId} is the campaign's unguessable invite code (~70 bits),
    // so it is the shared secret only its members hold — Storage rules cannot read
    // Firestore to check membership, so the unguessable path IS the gate (mirrors
    // the join-by-code model). Writes are size- + image-type-validated.
    match /campaigns/{campaignId}/banner.jpeg {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Map backgrounds (stage 5, docs/superpowers/specs/2026-09-04-v2-stage-5-minimum-map-design.md
    // §7): `campaigns/{campaignId}/maps/{mapId}.jpeg`. Membership and the DM are read from
    // the campaign document through the same cross-service lookup `isAdmin()` uses. The DM
    // (or the admin) uploads and deletes; every member may read — which also covers `list`,
    // the per-campaign quota's source of truth. Display goes through the token URL stored in
    // the encounter log, so a member's <img> never evaluates this rule. Size and type are
    // ceilings the adapter (`src/lib/map-io.ts`) already enforces after compression.
    match /campaigns/{campaignId}/maps/{fileName} {
      function campaign() {
        return firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data;
      }
      function isCampaignMember() {
        return request.auth != null && request.auth.uid in campaign().members;
      }
      function isCampaignDm() {
        return request.auth != null && request.auth.uid == campaign().dmUid;
      }
      // The campaign predicate comes FIRST on purpose: a rules evaluation may touch at most
      // two Firestore documents, and `isAdmin()` errors (never `false`) for a uid with no
      // `users/{uid}` document — so the common case short-circuits after one read, and a DM
      // whose profile document is missing is not locked out of the maps.
      allow read: if isCampaignMember() || isAdmin();
      allow create, update: if (isCampaignDm() || isAdmin())
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCampaignDm() || isAdmin();
    }

    // Bug-report screenshots (OWN-37). The owner of the report uploads its own
    // screenshot to a uid-scoped path; only the admin may read them (the Cloud
    // Function resolves a signed URL via the Admin SDK, bypassing these rules).
    // Writes are size- + image-type-validated to keep the free tier tiny.
    match /bug-reports/{uid}/{fileName} {
      // Owner can read their own screenshot (needed for getDownloadURL at submit time);
      // admin can read all.
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
